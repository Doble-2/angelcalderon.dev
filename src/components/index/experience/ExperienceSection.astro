---
import {
  Code,
  Palette,
  Database,
  Globe,
} from "lucide-react";
interface Props {
  lang: string;
  t: (key: string) => string;
}
const { lang = "es", t = (k) => k } = Astro.props;

const skills = [
  { name: "Frontend", icon: Code, technologies: ["React", "Next.js", "TypeScript", "Tailwind CSS"] },
  { name: "Backend", icon: Database, technologies: ["Node.js", "Python", "PostgreSQL", "MongoDB"] },
  { name: "Design", icon: Palette, technologies: ["Figma", "Adobe XD", "UI/UX", "Prototyping"] },
  { name: "DevOps", icon: Globe, technologies: ["AWS", "Docker", "CI/CD", "Vercel"] },
];

const experiences = [
  {
    year: "Feb 2024 - Jul 2024",
    title: "Semi-Senior Mobile Developer",
    company: "DeepCompany",
    description:
      "Contribuí al desarrollo de aplicaciones móviles utilizando Flutter, enfocándome en la experiencia del usuario, el rendimiento y la estética visual.",
  },
  {
    year: "Jul 2023 - Dic 2023",
    title: "Frontend Developer",
    company: "OverGroup",
    description:
      "Desarrollé interfaces web y móviles con Next.js y TailwindCSS; participé en proyectos cripto y de pagos.",
  },
  {
    year: "Abr 2022 - Dic 2023",
    title: "Junior Developer",
    company: "Colpixtec",
    description:
      "Trabajé con JavaScript, PHP y MySQL, contribuyendo al desarrollo de un marketplace y consumiendo APIs REST.",
  },
];
---

<section class="max-w-6xl mx-auto px-4">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-extrabold">{t('professional_experience')}</h2>
    <p class="mt-2 text-muted-foreground max-w-2xl mx-auto">{t('experience_description_1')}</p>
    <p class="mt-2 text-muted-foreground max-w-2xl mx-auto">{t('experience_description_2')}</p>
  </div>

  <!-- Skills grid -->
  <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
    {skills.map((skill) => (
      <div class="bg-white text-foreground flex flex-col gap-4 rounded-xl border py-6 shadow-sm neomorphic hover:shadow-lg transition-all duration-300 text-center p-6 backdrop-blur-xl">
        <skill.icon className="h-12 w-12 text-blue-600 mx-auto mb-2" />
        <h3 class="font-bold text-lg mb-1">{skill.name}</h3>
        <div class="flex flex-wrap justify-center gap-2">
          {(skill.technologies || []).map((tech) => (
            <span class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-foreground text-xs font-medium">{tech}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

</section>

