---
import TechnologyTag from "../projects/TechnologyTag";
import { featured } from "../../../data/projects";
import { jobs } from "../../../data/experience";
import { getCollection } from "astro:content";

interface Props {
  lang: string;
  t: (key: string) => string;
}
const { t = (k: string) => k, lang = "es" } = Astro.props as Props;
const L = lang === "en" ? "en" : "es";

const certifieds = await getCollection("certifieds");

// Datos, no párrafos: se entiende de un vistazo
const stats = [
  // Desarrollando desde diciembre de 2021; se recalcula en cada build.
  { value: `${Math.floor((Date.now() - Date.UTC(2021, 11, 1)) / (365.25 * 864e5))}+`, label: t("stat_years") },
  { value: String(featured().length), label: t("stat_projects") },
  { value: "#2", label: t("stat_award") },
  { value: String(certifieds.length), label: t("stat_certs") },
];

const stackA = ["Python", "FastAPI", "Nextjs", "React", "Typescript", "Astro", "TailwindCSS", "Nodejs", "PostgreSQL", "Redis", "MongoDB", "Docker", "Vercel"];
const stackB = ["Flutter", "Dart", "React Native", "RAG", "AI Agents", "LLM", "OpenAI", "DeepSeek API", "Vector DB", "WhatsApp Cloud API", "Firebase", "GitHub Actions", "Linux (Arch)"];

const timeline = jobs.map((j) => ({
  period: j.period[L],
  role: j.role[L],
  company: j.company,
  mode: j.mode[L],
  description: j.description[L],
  highlights: j.tags,
}));
---

<div class="container-content">
  <h2 class="type-h2">{t("nav_experience")}</h2>

  <dl class="mt-12 grid grid-cols-2 gap-y-10 md:grid-cols-4">
    {stats.map((s) => (
      <div class="flex flex-col border-l border-white/10 pl-5">
        <dt class="text-sm text-muted-foreground">{s.label}</dt>
        <dd class="order-first font-display text-7xl md:text-8xl leading-none text-white">{s.value}</dd>
      </div>
    ))}
  </dl>

  <!-- Trayectoria: los 3 trabajos más recientes con detalle; el resto, compacto y plegado -->
  <div class="mt-16">
    <h3 class="mb-6 text-lg font-semibold text-white">{t("exp_timeline_title")}</h3>
    <ol class="divide-y divide-white/10 border-y border-white/10">
      {timeline.slice(0, 3).map((e) => (
        <li class="grid gap-x-8 gap-y-1 py-5 md:grid-cols-[11rem_1fr]">
          <div class="text-xs uppercase tracking-wider text-muted-foreground md:pt-1">
            <span class="block">{e.period}</span>
            <span class="mt-0.5 block normal-case tracking-normal text-white/40">{e.mode}</span>
          </div>
          <div>
            <h4 class="font-semibold leading-snug text-white">{e.role} <span class="font-normal text-white/60">· {e.company}</span></h4>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{e.description}</p>
            <p class="mt-2 text-xs text-white/50">{e.highlights.join(" · ")}</p>
          </div>
        </li>
      ))}
    </ol>
    <details class="group border-b border-white/10">
      <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-sm font-semibold text-white/80 hover:text-white [&::-webkit-details-marker]:hidden">
        {t("exp_more")} ({timeline.length - 3})
        <span class="transition-transform group-open:rotate-180" aria-hidden="true">⌄</span>
      </summary>
      <ol class="pb-2">
        {timeline.slice(3).map((e) => (
          <li class="grid gap-x-8 py-2.5 text-sm md:grid-cols-[11rem_1fr]">
            <span class="text-xs uppercase tracking-wider text-muted-foreground md:pt-0.5">{e.period}</span>
            <span class="text-white">{e.role} <span class="text-white/60">· {e.company}</span> <span class="text-white/40">· {e.highlights.slice(0, 3).join(", ")}</span></span>
          </li>
        ))}
      </ol>
    </details>
  </div>
</div>
</div>

<!-- Stack: dos franjas en sentidos opuestos -->
<div class="mt-16 flex flex-col gap-3" role="group" aria-label={t("stat_stack")}>
  {[stackA, stackB].map((stack, i) => (
    <div class="marquee" data-reverse={i === 1 ? "" : undefined} style={`--marquee-duration:${i ? 46 : 38}s`}>
      {[0, 1].map((copy) => (
        <ul class="marquee-track" aria-hidden={copy === 1 ? "true" : undefined}>
          {stack.map((tech) => (
            <li><TechnologyTag tech={tech} size="lg" /></li>
          ))}
        </ul>
      ))}
    </div>
  ))}
</div>
