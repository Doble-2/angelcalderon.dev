---
import {
  Code,
  Palette,
  Database,
  Globe,
} from "lucide-react";
import TechnologyTag from "../projects/TechnologyTag";
interface Props {
  lang: string;
  t: (key: string) => string;
}
const { lang = "es", t = (k) => k } = Astro.props;

const gradients = [
  "from-blue-400 via-indigo-500 to-purple-500",
  "from-emerald-400 via-teal-400 to-cyan-500",
  "from-pink-400 via-rose-400 to-yellow-400",
  "from-orange-400 via-amber-400 to-yellow-500",
];

const skills = [
  { name: "Frontend", icon: Code, technologies: ["React", "Nextjs", "TypeScript", "TailwindCSS", "Flutter", "Astro"], gradient: gradients[0] },
  { name: "Backend", icon: Database, technologies: ["Nodejs", "Python", "Firebase", "PHP"], gradient: gradients[1] },
  { name: "Design", icon: Palette, technologies: ["Figma",  "UI/UX", "Prototyping"], gradient: gradients[2] },
  { name: "DevOps", icon: Globe, technologies: ["Vercel"], gradient: gradients[3] },
];

const experiences = [
  {
    year: "Mar 2025 - Presente",
    title: "Frontend Developer",
    company: "Cryptoportfolio",
    descriptionKey: "exp_cryptoportfolio_2025",
  },
  {
    year: "Feb 2024 - Jul 2024",
    title: "Semi-Senior Mobile Developer",
    company: "DeepCompany",
    descriptionKey: "exp_deepcompany_2024",
  },
  {
    year: "Jul 2023 - Dic 2023",
    title: "Frontend Developer",
    company: "OverGroup",
    descriptionKey: "exp_overgroup_2023",
  },
  {
    year: "Abr 2022 - Dic 2023",
    title: "Junior Developer",
    company: "Colpixtec",
    descriptionKey: "exp_colpixtec_2022",
  },
];
---

<section class="max-w-6xl mx-auto px-4">
  <div class="text-center mb-8">
    <h2 class="text-4xl font-bold">{t('professional_experience')}</h2>
    <p class="mt-2 text-muted-foreground max-w-2xl mx-auto text-xl">{t('experience_description_1')}</p>
    <p class="mt-2 text-muted-foreground max-w-2xl mx-auto text-xl">{t('experience_description_2')}</p>
  </div>

  <!-- Skills grid -->
  <div class="grid sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
    {skills.map((skill, idx) => (
      <div class="bg-white text-foreground flex flex-col gap-4 rounded-2xl border border-transparent hover:border-gray-200/60 py-6 shadow-md hover:shadow-xl transition-all duration-300 text-center p-6 backdrop-blur-sm">
        <div class="w-20 h-20 rounded-full mx-auto mb-3 flex items-center justify-center transform transition-transform duration-300 hover:scale-105" style="background: linear-gradient(135deg, var(--tw-gradient-stops));">
          <div class={`w-12 h-12 rounded-full flex items-center justify-center text-white bg-gradient-to-br ${skill.gradient}`}>
            <skill.icon className="h-6 w-6" />
          </div>
        </div>
  <h3 class="font-semibold text-lg mb-1">{t(skill.name.toLowerCase())}</h3>
        <div class="flex flex-wrap justify-center gap-2">
          {(skill.technologies || []).map((tech) => (
            <TechnologyTag tech={tech} />
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Experience timeline -->
  <div class="mt-10">
    <ol class="space-y-6">
      {experiences.map((exp) => (
        <li class="bg-white/90 p-6 rounded-2xl shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <div>
              <h4 class="font-semibold">{exp.title} — <span class="font-normal">{exp.company}</span></h4>
              <time class="text-sm text-muted-foreground">{exp.year}</time>
            </div>
          </div>
          <p class="mt-3 text-muted-foreground">{t(exp.descriptionKey)}</p>
        </li>
      ))}
    </ol>
  </div>

</section>

