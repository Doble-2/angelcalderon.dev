---
interface Props {
  lang: string;
  t: (key: string) => string;
}
const { t = (k: string) => k } = Astro.props as Props;
---

<div class="container-content">
  <div class="grid gap-10 md:grid-cols-12 md:items-center md:gap-16">
    <!-- Retrato grande: es la imagen más reconocible de la página -->
    <figure class="about-photo reveal md:col-span-5">
      <img
        src="/profile.webp"
        alt="Ángel Calderón"
        width="1400"
        height="1400"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
        {t("about_available")}
      </figcaption>
    </figure>

    <div class="md:col-span-7">
      <h2 class="type-h2">{t("about_title")}</h2>
      <div class="mt-5 h-1 w-16 rounded-full bg-[#800020]" aria-hidden="true"></div>
      <div class="mt-8 max-w-xl space-y-5">
        <p class="text-lg leading-relaxed text-white md:text-xl">{t("about_p1")}</p>
        <p class="text-base leading-relaxed text-muted-foreground">{t("about_p2")}</p>
        <p class="border-l-2 border-[#c2185b]/60 pl-4 text-base leading-relaxed text-muted-foreground">{t("about_p3")}</p>
      </div>
    </div>
  </div>
</div>
