---
import { Image } from "astro:assets";
const { project, t } = Astro.props;
---

<section class="relative group">
  <div class={`absolute inset-0 rounded-3xl blur-lg sm:blur-xl opacity-40 sm:opacity-50 transition-all duration-700`} style={`background: linear-gradient(135deg, ${project?.color || '#0000'} 0%, transparent 60%);`} />

  <article class="relative neomorphic overflow-hidden bg-background/80 backdrop-blur-none sm:backdrop-blur-sm rounded-2xl">
    <div class="aspect-video relative overflow-hidden">
      {project?.images && project.images[0]
        ? <Image src={`/projects/${encodeURIComponent(project.name)}/${encodeURIComponent(project.images[0])}`} alt={project.name} width={1200} height={675} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        : <div class="w-full h-full bg-muted/40" />}

      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />

      <div class="absolute top-6 right-6 flex gap-3">
        <a href={project?.link || '#'} class="inline-flex items-center justify-center bg-white/20 backdrop-blur-sm sm:backdrop-blur-md border border-white/20 text-white rounded-full p-2 transition-transform duration-200 hover:-translate-y-0.5">
          🔗
        </a>
        <a href={project?.repo || '#'} class="inline-flex items-center justify-center bg-white/10 backdrop-blur-sm sm:backdrop-blur-md border border-white/30 text-white rounded-full p-2 transition-transform duration-200 hover:-translate-y-0.5">
          💻
        </a>
      </div>

      <div class="absolute bottom-6 left-6 right-6 text-white">
        <div class="flex items-center gap-3 mb-3">
          <span class="bg-primary/90 text-primary-foreground px-3 py-1 rounded-full text-sm">{project?.category}</span>
          <span class="text-muted-foreground text-sm">{project?.year} • {project?.duration}</span>
        </div>
        <h3 class="text-2xl font-bold text-white mb-2">{project?.title}</h3>
      </div>
    </div>

    <div class="p-8">
      <p class="text-lg text-muted-foreground mb-6 leading-relaxed">{project?.description}</p>

      <div class="grid md:grid-cols-3 gap-6 mb-6">
        <div>
          <h4 class="font-semibold text-primary">{t('challenge')}</h4>
          <p class="text-sm text-muted-foreground">{project?.challenge}</p>
        </div>
        <div>
          <h4 class="font-semibold text-primary">{t('solution')}</h4>
          <p class="text-sm text-muted-foreground">{project?.solution}</p>
        </div>
        <div>
          <h4 class="font-semibold text-primary">{t('impact')}</h4>
          <p class="text-sm text-muted-foreground">{project?.impact}</p>
        </div>
      </div>

      <div class="flex gap-4">
        <a class="btn btn-primary flex-1" href={project?.case || '#'}>{t('viewCase')}</a>
        <a class="btn btn-secondary flex-1" href={project?.demo || '#'}>{t('liveDemo')}</a>
      </div>
    </div>
  </article>
</section>
