---
import { Image } from "astro:assets";
const { project, t } = Astro.props;

const slugify = (v: string) =>
  String(v || "")
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const slug = project?.slug || slugify(project?.name);
const rawFirst = project?.images?.[0] ? String(project.images[0]) : "";
const heroSrc = rawFirst
  ? rawFirst.startsWith("http") || rawFirst.startsWith("/")
    ? rawFirst
    : `/projects/${encodeURIComponent(slug)}/${encodeURIComponent(rawFirst)}`
  : "";

const safeUrl = (u: unknown) => {
  if (!u) return null;
  const s = String(u).trim();
  if (!s || s === "#") return null;
  return s;
};

const linkUrl = safeUrl(project?.link);
const repoUrl = safeUrl(project?.repo);
const caseUrl = safeUrl(project?.case);
const demoUrl = safeUrl(project?.demo);
---

<section class="relative group">
  <div class={`absolute inset-0 rounded-3xl blur-lg sm:blur-xl opacity-40 sm:opacity-50 transition-all duration-700`} style={`background: linear-gradient(135deg, ${project?.color || '#0000'} 0%, transparent 60%);`} />

  <article class="relative neomorphic overflow-hidden backdrop-blur-none sm:backdrop-blur-sm rounded-2xl">
    <div class="aspect-video relative overflow-hidden">
      {heroSrc
        ? <Image src={heroSrc} alt={project.name} width={1200} height={675} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        : <div class="w-full h-full bg-muted/40" />}

      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />

      <div class="absolute top-6 right-6 flex gap-3">
        {linkUrl ? (
          <a href={linkUrl} class="icon-btn icon-btn-primary" aria-label="Open link" target="_blank" rel="noopener noreferrer">
            🔗
          </a>
        ) : null}
        {repoUrl ? (
          <a href={repoUrl} class="icon-btn icon-btn-brand-github" aria-label="Open GitHub repo" target="_blank" rel="noopener noreferrer">
            💻
          </a>
        ) : null}
      </div>

      <div class="absolute bottom-6 left-6 right-6 text-white">
        <div class="flex items-center gap-3 mb-3">
          <span class="bg-primary/90 text-primary-foreground px-3 py-1 rounded-full text-sm">{project?.category}</span>
          <span class="text-muted-foreground text-sm">{project?.year} • {project?.duration}</span>
        </div>
        <h3 class="text-2xl font-bold text-white mb-2">{project?.title}</h3>
      </div>
    </div>

    <div class="p-8">
      <p class="text-lg text-muted-foreground mb-6 leading-relaxed">{project?.description}</p>

      <div class="grid md:grid-cols-3 gap-6 mb-6">
        <div>
          <h4 class="font-semibold text-primary">{t('challenge')}</h4>
          <p class="text-sm text-muted-foreground">{project?.challenge}</p>
        </div>
        <div>
          <h4 class="font-semibold text-primary">{t('solution')}</h4>
          <p class="text-sm text-muted-foreground">{project?.solution}</p>
        </div>
        <div>
          <h4 class="font-semibold text-primary">{t('impact')}</h4>
          <p class="text-sm text-muted-foreground">{project?.impact}</p>
        </div>
      </div>

      <div class="flex gap-4">
        {caseUrl ? (
          <a class={demoUrl ? "btn btn-primary flex-1" : "btn btn-primary w-full"} href={caseUrl}>{t('viewCase')}</a>
        ) : (
          <a class={demoUrl ? "btn btn-primary flex-1" : "btn btn-primary w-full"} href={`/projects/${encodeURIComponent(slug)}`}>{t('viewCase')}</a>
        )}
        {demoUrl ? (
          <a class="btn btn-secondary flex-1" href={demoUrl} target="_blank" rel="noopener noreferrer">{t('liveDemo')}</a>
        ) : null}
      </div>
    </div>
  </article>
</section>
