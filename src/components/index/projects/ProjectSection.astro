---
import FeaturedProject from "./FeaturedProject.astro";
import ProjectCard from "./ProjectCard.astro";
import ProjectsClient from "./ProjectsClient.astro";

interface Props {
    lang: string;
    t: (key: string) => string;
}
const { lang = 'es', t = (k) => k } = Astro.props;
import { getFirestore, collection, getDocs } from "firebase/firestore";
import app from "../../../firebase/client";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const db = getFirestore(app);
let projects = [];
try {
    const queryProjects = await getDocs(collection(db, "projects"));
    const docsProjects = [];
    queryProjects.forEach((doc) => {
        docsProjects.push({ ...doc.data(), id: doc.id });
    });
    projects = docsProjects.sort((a, b) => {
        if (a.order > b.order) {
            return -1;
        }
        if (a.order < b.order) {
            return 1;
        }
        return 0;
    });
} catch (e) {
    // If fetching projects fails during build/SSR, log and continue with empty list
    console.error('Failed to fetch projects:', e);
    projects = [];
}
---

<section id="proyectos" class=" px-4 relative z-10 overflow-hidden w-full" data-server-projects-count={projects.length}>
    <div class="  relative">
        <div class="text-center mb-6">
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 bg-gradient-to-r from-foreground to-foreground/70 bg-clip-text ">{t('projects')}</h2>
        </div>

        <div >
            <!-- Render client-side interactive projects UI -->
            <ProjectsClient
                projects={projects}
                labels={{
                    viewCase: t('viewCase'),
                    liveDemo: t('liveDemo'),
                    challenge: t('challenge'),
                    solution: t('solution'),
                    impact: t('impact'),
                    projectsTitle: t('projects'),
                    projectsSubtitle: t('projectsSubtitle')
                }}
                lang={lang}
            />
        </div>
       <!-- <div class="mt-8 text-center">
            <a href="/projects" class="text-sm font-semibold underline underline-offset-4 decoration-1 text-blue-500 hover:text-blue-600 flex items-center justify-center gap-1">
                {t('see_more_projects')}
            </a>
        </div>--> 
        
    </div>
</section>
