---
import ProjectsClient from "./ProjectsClient.astro";
import { projects } from "../../../data/projects";

interface Props {
    lang: string;
    t: (key: string) => string;
}
const { lang = 'es', t = (k) => k } = Astro.props;

// Solo muestra proyectos que quieras destacar; el orden lo define `order` (desc).
// Aquí reutilizamos el array tipado del portfolio.
const featured = [...projects].sort((a, b) => b.order - a.order);
---

<div class="relative z-10 overflow-hidden w-full" data-server-projects-count={featured.length}>
    <div class="container-content relative">
        <div class="text-center mb-10">
            <h2 class="type-h2 mb-2 bg-gradient-to-r from-foreground to-foreground/70 bg-clip-text text-transparent">{t('projects')}</h2>
            <p class="mt-2 max-w-2xl mx-auto type-lead text-muted-foreground">{t('projectsSubtitle')}</p>
        </div>

        <div>
            <!-- Render client-side interactive projects UI -->
            <ProjectsClient
                projects={featured as any}
                labels={{
                    viewCase: t('viewCase'),
                    liveDemo: t('liveDemo'),
                    challenge: t('challenge'),
                    solution: t('solution'),
                    impact: t('impact'),
                    projectsTitle: t('projects'),
                    projectsSubtitle: t('projectsSubtitle')
                }}
                lang={lang}
            />
        </div>
    </div>
</div>
            </a>

