---
import FeaturedProject from "./FeaturedProject.astro";
import ProjectCard from "./ProjectCard.astro";
import ProjectsClient from "./ProjectsClient.jsx";

interface Props {
    lang: string;
    t: (key: string) => string;
}
const { lang = 'es', t = (k) => k } = Astro.props;
import { getFirestore, collection, getDocs } from "firebase/firestore";
import app from "../../../firebase/client";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const db = getFirestore(app);
let projects = [];
try {
    const queryProjects = await getDocs(collection(db, "projects"));
    const docsProjects = [];
    queryProjects.forEach((doc) => {
        docsProjects.push({ ...doc.data(), id: doc.id });
    });
    projects = docsProjects.sort((a, b) => {
        if (a.order > b.order) {
            return -1;
        }
        if (a.order < b.order) {
            return 1;
        }
        return 0;
    });
} catch (e) {
    // If fetching projects fails during build/SSR, log and continue with empty list
    console.error('Failed to fetch projects:', e);
    projects = [];
}
---

<section id="proyectos" class=" px-6 relative z-10 overflow-hidden" data-server-projects-count={projects.length}>
    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-primary/10" />
    <div class="absolute top-1/4 -right-64 w-96 h-96 bg-gradient-to-l from-primary/10 to-transparent rounded-full blur-3xl" />
    <div class="absolute bottom-1/4 -left-64 w-96 h-96 bg-gradient-to-r from-primary/10 to-transparent rounded-full blur-3xl" />

    <div class=" mx-auto relative">
        <div class="text-center mb-20">
            <h2 class="text-3xl font-bold mb-4 bg-gradient-to-r from-foreground to-foreground/70 bg-clip-text ">Proyectos Destacados</h2>
            <div class="inline-block px-4 py-2 bg-primary/10 rounded-full text-sm font-medium text-primary">Portfolio actualizado hasta octubre 2025</div>
        </div>

        <div>
            <!-- Render client-side interactive projects UI -->
            <ProjectsClient
                client:load
                projects={projects}
                labels={{
                    viewCase: t('viewCase'),
                    liveDemo: t('liveDemo'),
                    challenge: t('challenge'),
                    solution: t('solution'),
                    impact: t('impact'),
                    projectsTitle: t('projects'),
                    projectsSubtitle: t('projectsSubtitle')
                }}
                lang={lang}
            />
        </div>
    </div>
</section>
