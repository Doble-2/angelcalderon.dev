---
import { Image } from "astro:assets";

const { className, href, title, image, color } = Astro.props;
// `color` queda para compatibilidad, pero este componente no lo usa.
// Evita warning de variable no usada.
void color;
---

<div
    class:list={[
        `col-span-2 rounded-xl max-h-[50vh] flex flex-col items-center bg-gradient-to-tl from-[#000000]/[.3]  to-[#000000]/[.3]`,
        className,
    ]}
>
    <Image
        height={320}
        width={512}
        loading="lazy"
        class="object-fill w-64"
        src={image}
        alt={title}
    />
    <div
        class="relative bottom-8 flex flex-col items-center justify-center w-full gap-2 font-bold"
    >
        {title}
        <a
            href={href}
            class="btn btn-primary btn-sm w-44 min-h-8 text-center"
            aria-label={`Ver más ${title}`}
        >
            Ver más
        </a>
    </div>
</div>
