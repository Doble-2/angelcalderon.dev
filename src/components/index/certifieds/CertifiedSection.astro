---
import CertifiedContainer from "./CertifiedContainer.astro";
import { getCollection } from "astro:content";

interface Props {
  lang: string;
  t: (key: string) => string;
}
const { lang = "es", t = (k) => k } = Astro.props;

const entries = await getCollection("certifieds");
const certifieds = entries
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => Number(b.order) - Number(a.order));
---
<div class="px-4 flex flex-col w-full gap-2">


<div
  class=" flex items-center  sm:flex  mx-auto lg:gap-8 xl:gap-0 lg:grid-cols-12 "
>
  <div class="flex-col text-center">
    <div class="mb-4 sm:mb-0 sm:mr-12 place-self-center lg:col-span-7">
      <div class="">
        <h2 class="text-3xl mb-2 font-extrabold md:text-3xl xl:text-4xl">
          {t("certificates")}
        </h2>
      </div>
    </div>

    <p class="max-w-2xl mb-2 text-lg md:text-lg lg:text-xl">
      {t("certifieds_description_1")}
    </p>

    <p class="max-w-2xl mb-2 text-lg md:text-lg lg:text-xl">
      {t("certifieds_description_2")}
    </p>
  </div>
</div>

<div class="mb-6 max-w-screen-xl mx-auto">
  {
    certifieds.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {certifieds.map((certified) => (
          <CertifiedContainer
            className="w-full"
            variant="row"
            href={"/certifieds/" + certified.asset + ".pdf"}
            title={certified.name}
            image={"/certifieds/" + certified.asset + ".jpg"}
          />
        ))}
      </div>
    )
  }
</div>
</div>