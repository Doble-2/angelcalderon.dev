---
import CertifiedContainer from "./CertifiedContainer.astro";
import { getCollection } from "astro:content";

interface Props {
  lang: string;
  t: (key: string) => string;
}
const { t = (k: string) => k } = Astro.props as Props;

const entries = await getCollection("certifieds");
const certifieds = entries
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => Number(b.order) - Number(a.order));
---
<div class="flex flex-col w-full gap-10">
  <div class="container-content text-center">
    <h2 class="type-h2 mb-3">{t("certificates")}</h2>
    <p class="type-lead text-muted-foreground max-w-2xl mx-auto">
      {t("certifieds_description_1")}
    </p>
    <p class="type-lead text-muted-foreground max-w-2xl mx-auto mt-2">
      {t("certifieds_description_2")}
    </p>
  </div>

<div class="container-content">
  {
    certifieds.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {certifieds.map((certified) => (
          <CertifiedContainer
            className="w-full"
            variant="row"
            href={"/certifieds/" + certified.asset + ".pdf"}
            title={certified.name}
            image={"/certifieds/" + certified.asset + ".jpg"}
          />
        ))}
      </div>
    )
  }
</div>
</div>