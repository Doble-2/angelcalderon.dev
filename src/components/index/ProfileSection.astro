---
import { Image } from "astro:assets";
interface Props {
  lang: string;
  t: (key: string) => string;
}
const { lang = 'es', t = (k) => k } = Astro.props;
---

<div class="lg:mr-20 place-self-center lg:col-span-7 pt-6 md:pt-0">
  <div class="">
    <h1
      class="max-w-2xl mb-4 tracking-tight leading-none text-2xl font-bold md:text-1xl xl:text-2xl"
    >
      Ángel Calderón
      <p class="text-3xl font-extrabold md:text-3xl xl:text-4xl">
        {t('frontend_developer')}
      </p>
    </h1>
  </div>

  <p class="max-w-2xl lg:mb-8 text-lg md:text-lg lg:text-xl xl:text-2xl">
    {t('profile_description_1')}
    <span class="hidden md:block">{t('profile_description_2')}</span>
    {t('profile_description_3')}
  </p>
  </p>
  <div class="flex items-center justify-center md:justify-start mt-10 md:mt-6">
    <a href="/Angel Calderon Semi-Senior.pdf" download class="font-semibold text-white">
      <button
        class="bg-blue-600 text-white py-3 px-4 rounded-full flex justify-center items-center min-h-12 lg:text-xl"
      >
    {t('download_cv')}
      </button>
    </a>

    <!-- <a href="/profile.png" download class="text-sm font-semibold">

    <button
      class="hidden sm:flex text-blue-600 hover:text-white hover:bg-blue-600 hover:text-white border-blue-600 border-2 text-blue-600 py-3 px-4 rounded-full flex justify-center items-center ml-4 w-44 min-h-14"
    >
        Contactame
    </button>
  </a> -->
  </div>
</div>
<div class="sm:mt-0 lg:col-span-5 flex justify-center mt-2 ">
  <Image
    class="rounded-t-lg ProfileImage z-4 drop-shadow-xl"
    width={400}
    height={400}
    loading="eager"
    src={"/profile.webp"}
    alt="foto de angel calderon"
  />
</div>
