---
import Petals from "../share/Petals.astro";

interface Props {
  lang: string;
  t: (key: string) => string;
}
const { t = (k: string) => k } = Astro.props as Props;

const srcset = (name: string) => `/hero/${name}-1280.webp 1280w, /hero/${name}-2560.webp 2560w`;
---

<section aria-label={t("hero_aria")} class="hero relative h-[100svh] min-h-[560px] overflow-hidden">
  <!-- 1. Cielo + montaña (foto completa) -->
  <img
    src="/hero/avila-1280.webp"
    srcset={srcset("avila")}
    sizes="100vw"
    alt=""
    fetchpriority="high"
    decoding="async"
    class="hero-layer hero-sky"
  />

  <div class="hero-top-shade" aria-hidden="true"></div>

  <!-- 2. Flores lejanas, detrás de la montaña -->
  <div class="absolute inset-0">
    <Petals />
  </div>

  <!-- 3. Nombre: queda detrás del pico -->
  <h1 class="hero-name" data-hero-name>
    <span>Ángel</span> <span>Calderón</span>
  </h1>

  <!-- 4. El pico recortado tapa la parte baja del nombre -->
  <img
    src="/hero/avila-peak-1280.webp"
    srcset={srcset("avila-peak")}
    sizes="100vw"
    alt=""
    decoding="async"
    class="hero-layer"
  />

  <!-- 5. Lo mínimo para decidir: qué hago y qué hacer ahora -->
  <div class="absolute inset-x-0 bottom-0 z-[45] bg-gradient-to-t from-background via-background/70 to-transparent pt-32">
    <div class="container-page pb-8 md:pb-10">
      <div class="container-content flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <p class="max-w-md text-lg md:text-xl leading-snug text-white">
          {t("hero_role")}
          <span class="block text-sm text-white/60 mt-1">
            <span class="mr-1.5 inline-block h-1.5 w-1.5 -translate-y-px rounded-full bg-emerald-400"></span>
            {t("hero_status")}
          </span>
        </p>
        <div class="flex items-center gap-3">
          <a href="#proyectos" class="btn btn-primary h-12 px-6 text-base">{t("hero_cta_projects")}</a>
          <a href="#contacto" class="btn btn-secondary h-12 px-6 text-base">{t("hero_cta_contact")}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Flores cercanas: fijas sobre toda la página (fuera del hero para quedar por encima del resto) -->
<canvas id="petals-front" class="pointer-events-none fixed inset-0 z-40 h-full w-full" aria-hidden="true"></canvas>

<script>
  // Parallax sutil del nombre con el cursor: se mueve "entre" cielo y montaña
  const name = document.querySelector<HTMLElement>("[data-hero-name]");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (name && fine && !reduce) {
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const tick = () => {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      name.style.setProperty("--px", `${x.toFixed(2)}px`);
      name.style.setProperty("--py", `${y.toFixed(2)}px`);
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.05 ? requestAnimationFrame(tick) : 0;
    };
    window.addEventListener("pointermove", (e) => {
      tx = (e.clientX / window.innerWidth - 0.5) * -18;
      ty = (e.clientY / window.innerHeight - 0.5) * -8;
      if (!raf) raf = requestAnimationFrame(tick);
    }, { passive: true });
  }
</script>
