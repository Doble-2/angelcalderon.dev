---
import { Icon } from "astro-icon/components";
import translations from "../../i18n";
import { resolveLangFromRequest } from "../../lib/lang";

const lang = resolveLangFromRequest(Astro.request);
const t = (key: string) => translations[lang]?.[key] || key;

const year = new Date().getFullYear();
const basePath = lang === 'en' ? '/en' : '/';
---

<footer role="contentinfo" aria-label={t('footerAria')} class="">
  <div class="">
    <div class="surface-panel section-panel neo-border  px-6 py-6 md:px-8 md:py-7">
      <div class="grid gap-6 md:gap-8 md:grid-cols-12 items-start">
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center">
            <span class="text-sm font-semibold text-foreground">AC</span>
          </div>
          <div>
            <p class="font-semibold text-foreground">angelcalderon.dev</p>
            <p class="text-sm text-muted-foreground">{t('footerTagline')}</p>
          </div>
        </div>

        <p class="mt-3 text-sm text-muted-foreground">
          <span class="text-foreground opacity-90">{t('open')}</span> · {t('footerResponse')} · {t('footerTimezone')}
        </p>

        <div class="mt-4 flex flex-wrap gap-3">
          <a class="btn btn-primary btn-sm" href="mailto:hola@angelcalderon.dev">{t('footerEmailMe')}</a>
          <a
            class="btn btn-brand-whatsapp btn-sm"
            href="https://wa.me/584241922882?text=Hola%20acabo%20de%20ver%20tu%20portfolio%20y%20me%20encantar%C3%ADa%20ponerme%20en%20contacto%20contigo"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('footerWhatsAppMe')}
          </a>
        </div>
      </div>

      <div class="md:col-span-3">
        <p class="type-meta text-muted-foreground">{t('footerLinks')}</p>
        <nav aria-label={t('footerLinksAria')} class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
          <a class="text-foreground opacity-90 hover:opacity-100 transition-opacity" href={`${basePath}#main-content`}>{t('home')}</a>
          <a class="text-foreground opacity-90 hover:opacity-100 transition-opacity" href={`${basePath}#proyectos`}>{t('projects')}</a>
          <a class="text-foreground opacity-90 hover:opacity-100 transition-opacity" href={`${basePath}#certificados`}>{t('certificates')}</a>
          <a class="text-foreground opacity-90 hover:opacity-100 transition-opacity" href={`${basePath}#contacto`}>{t('contact')}</a>
        </nav>
      </div>

      <div class="md:col-span-4">
        <p class="type-meta text-muted-foreground">{t('footerSocial')}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <a
            class="icon-btn icon-btn-brand-linkedin"
            title="LinkedIn"
            href="https://www.linkedin.com/in/angeld2/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="prime:linkedin" class="w-5 h-5" aria-hidden="true" />
            <span class="sr-only">LinkedIn</span>
          </a>
          <a
            class="icon-btn icon-btn-brand-github"
            title="GitHub"
            href="https://github.com/Doble-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="prime:github" class="w-5 h-5" aria-hidden="true" />
            <span class="sr-only">GitHub</span>
          </a>
          <a
            class="icon-btn icon-btn-brand-whatsapp"
            title="WhatsApp"
            href="https://wa.me/584241922882?text=Hola%20acabo%20de%20ver%20tu%20portfolio%20y%20me%20encantar%C3%ADa%20ponerme%20en%20contacto%20contigo"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="prime:whatsapp" class="w-5 h-5" aria-hidden="true" />
            <span class="sr-only">WhatsApp</span>
          </a>
          <a
            class="icon-btn icon-btn-ghost bg-white/5 hover:bg-white/10"
            title="X"
            href="https://x.com/angelcaldev?t=UQAHOXx_gSOoTZp9THuJ4g&s=09"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="prime:twitter" class="w-5 h-5" aria-hidden="true" />
            <span class="sr-only">X</span>
          </a>
        </div>

        <p class="mt-4 text-xs text-muted-foreground max-w-sm">{t('footerMadeWith')}</p>
      </div>
      </div>

      <div class="mt-6 pt-4 border-t border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
        <p class="text-xs text-muted-foreground">© {year} Angel Calderon. {t('footerRights')}</p>
        <p class="text-xs text-muted-foreground">{t('footerLocation')}</p>
      </div>
    </div>
  </div>

</footer>
