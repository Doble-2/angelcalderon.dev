---
import { Icon } from "astro-icon/components";
import translations from "../../i18n";
import { resolveLangFromRequest } from "../../lib/lang";

interface Props {
  lang?: "es" | "en";
}

// Usa el idioma de la página; la request es solo un fallback.
const lang = Astro.props.lang ?? resolveLangFromRequest(Astro.request);
const t = (key: string) => translations[lang]?.[key] || key;

const year = new Date().getFullYear();
const basePath = lang === 'en' ? '/en' : '/';

---

<footer role="contentinfo" aria-label={t('footerAria')} class="border-t border-white/10">
  <div class="container-page py-8">
    <div class="container-content flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="text-sm text-muted-foreground">
        © {year} Ángel Calderón · {t('footerLocation')}
      </p>
      <div class="flex items-center gap-2">
        {[
          { name: "prime:linkedin", label: "LinkedIn", href: "https://www.linkedin.com/in/angeld2/" },
          { name: "prime:github", label: "GitHub", href: "https://github.com/Doble-2" },
          { name: "prime:twitter", label: "X", href: "https://x.com/angelcaldev" },
          { name: "prime:whatsapp", label: "WhatsApp", href: "https://wa.me/584241922882" },
        ].map((s) => (
          <a class="icon-btn icon-btn-ghost" title={s.label} href={s.href} target="_blank" rel="noopener noreferrer">
            <Icon name={s.name} class="w-5 h-5" aria-hidden="true" />
            <span class="sr-only">{s.label}</span>
          </a>
        ))}
        <a class="ml-2 text-sm text-white/70 hover:text-white" href={`${basePath}#main-content`}>{t('backToTop')} ↑</a>
      </div>
    </div>
  </div>
</footer>
