<footer role="contentinfo" aria-label="Redes sociales - Angel Calderon">
    <div class="bg-black md:place-self-center lg:col-span-7 px-8 lg:px-16 py-4 rounded-t-lg  w-full">
        <div class="flex justify-center items-center text-white">
            <a title="linkedin" href="https://www.linkedin.com/in/angeld2/" target="_blank" rel="noopener noreferrer">
                <Icon name={`prime:linkedin`} class="w-8 h-8 " aria-hidden="true" />
                <span class="sr-only">LinkedIn</span>
            </a>
            <a title="github" href="https://github.com/Doble-2" target="_blank" rel="noopener noreferrer">
                <Icon name={`prime:github`} class="w-8 h-8 " aria-hidden="true" />
                <span class="sr-only">GitHub</span>
            </a>
            <a title="whatsapp" href="https://wa.me/584241922882?text=Hola%20acabo%20de%20ver%20tu%20portfolio%20y%20me%20encantar%C3%ADa%20ponerme%20en%20contacto%20contigo" target="_blank" rel="noopener noreferrer">
                <Icon name={`prime:whatsapp`} class="w-8 h-8 " aria-hidden="true" />
                <span class="sr-only">WhatsApp</span>
            </a>
            <a title="x" href="https://x.com/angelcaldev?t=UQAHOXx_gSOoTZp9THuJ4g&s=09" target="_blank" rel="noopener noreferrer">
                <Icon name={`prime:twitter`} class="w-6 h-6" aria-hidden="true" />
                <span class="sr-only">X</span>
            </a>
        </div>
    </div>

    <!-- JSON-LD structured data for Person -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Angel Calderon",
        "url": "https://angelcalderon.dev",
        "sameAs": [
          "https://github.com/Doble-2",
          "https://www.linkedin.com/in/angeld2/",
          "https://x.com/angelcaldev"
        ],
        "jobTitle": "Desarrollador Web/Mobile",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Caracas",
          "addressCountry": "VE"
        },
        "knowsAbout": ["Flutter","React","Next.js","Python","DevOps","Figma"]
      })}
    </script>
</footer>
