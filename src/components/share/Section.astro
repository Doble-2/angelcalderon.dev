---
type Variant = 'panel' | 'transparent' | 'shell';
type Size = 'default' | 'hero' | 'tight';

const {
  className,
  id,
  role = 'region',
  ariaLabel = 'section',
  variant = 'panel',
  size = 'default',
} = Astro.props as {
  className?: string;
  id?: string;
  // Astro's TS in .astro doesn't expose `JSX` namespace reliably.
  // Keep this permissive; the rendered `role` attribute is still validated by browsers/AT.
  role?: any;
  ariaLabel?: string;
  variant?: Variant;
  size?: Size;
};

const sizeClasses: Record<Size, string> = {
  default: 'py-24 md:py-32',
  tight: 'py-20 md:py-28',
  hero: 'pt-24 pb-14 md:pt-28 md:pb-16 lg:pt-32 lg:pb-20',
};

const variantClasses: Record<Variant, string> = {
  panel: '',
  shell: 'surface-shell rounded-3xl',
  transparent: 'bg-transparent border-0 shadow-none backdrop-blur-0',
};
---

<section
  id={id}
  role={role}
  aria-label={ariaLabel}
  class:list={[
    'text-foreground container-page flex flex-col gap-8 md:gap-10',
    sizeClasses[size],
    variantClasses[variant],
    className,
  ]}
>
  <div class="w-full">
    <slot />
  </div>
</section>
