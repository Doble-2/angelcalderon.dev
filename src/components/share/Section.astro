---
const { className } = Astro.props;
---

<section
  role={Astro.props.role || 'region'}
  aria-label={Astro.props.ariaLabel || 'section'}
  class:list={[
    "surface-panel text-foreground container-page py-12 md:py-14 lg:py-16 flex flex-col gap-8 md:gap-10 main-section",
    className,
  ]}
>
  <div class="w-full">
    <slot />
  </div>
</section>
