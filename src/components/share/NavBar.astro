---
import { Image } from "astro:assets";

interface Props {
  lang: string;
  t: (key: string) => string;
}

const { lang = "es", t = (k) => k } = Astro.props;
---

<!-- bg-neutral-800/[.3] -->
<header
  id="site-header"
  class="z-50 fixed top-0 left-0 right-0 py-2 transition-colors duration-300"
  role="banner"
>
  <div class="flex justify-between items-center w-full mx-auto px-8">
    <a class="text-xl flex items-center gap-2" href="/#" aria-label="Inicio - Angel Calderon">
      <Image
        loading="eager"
        class="w-6 h-6 logo-img"
        width={12}
        height={12}
        src={"/rect1.png"}
        alt="Logo de Angel Calderon"
      />
      <h2 class="text-xl font-medium">angelcalderon.dev</h2>
    </a>
    <div class="flex items-center gap-2">
      <!-- Language Toggle -->
      <div class="relative">
        <button
          id="lang-toggle"
          class="liquid-glass-btn"
          aria-label={t("language")}
          type="button"
          tabindex="0"
        >
          {
            lang === "es" ? (
              <span class="flex items-center gap-2">
                <img
                  src="https://hatscripts.github.io/circle-flags/flags/es.svg"
                  alt="Español"
                  class="w-4 h-4 rounded-full"
                />
                <span class="hidden md:inline">{t("español")}</span>
              </span>
            ) : (
              <span class="flex items-center gap-2">
                <img
                  src="https://hatscripts.github.io/circle-flags/flags/gb.svg"
                  alt="English"
                  class="w-4 h-4 rounded-full"
                />
                <span class="text-sm hidden md:inline">{t("english")}</span>
              </span>
            )
          }
        </button>
        <div
          id="lang-menu"
          class="hidden absolute right-0 mt-2 w-32 bg-white dark:bg-neutral-900 rounded shadow-lg z-50"
        >
          <button
            class="block w-full text-left px-4 py-2 hover:bg-neutral-100 dark:hover:bg-neutral-800"
            data-lang="es"
          >
            <span class="flex items-center gap-2">
              <img
                src="https://hatscripts.github.io/circle-flags/flags/es.svg"
                alt="Español"
                class="w-5 h-5 rounded-full"
              />
              <span class="">{t("español")}</span>
            </span>
          </button>
          <button
            class="block w-full text-left px-4 py-2 hover:bg-neutral-100 dark:hover:bg-neutral-800"
            data-lang="en"
          >
            <span class="flex items-center gap-2">
              <img
                src="https://hatscripts.github.io/circle-flags/flags/gb.svg"
                alt="English"
                class="w-5 h-5 rounded-full"
              />
              <span>{t("english")}</span>
            </span>
          </button>
        </div>
      </div>
    </div>
    <!--

-->
  </div>
</header>

<script is:inline>
  // Utilidades tema
  // Utilidades idioma
  function setLanguage(lang) {
    try {
      document.cookie = `lang=${lang}; path=/;`;
    } catch (e) {}
    try {
      window.localStorage.setItem("lang", lang);
    } catch (e) {}
    location.reload();
  }

  // Interactividad toggles
  document.addEventListener("DOMContentLoaded", () => {
    const NAV_DEBUG =
      typeof window !== "undefined" &&
      (window.location.search.includes("navdebug=1") ||
        window.localStorage.getItem("nav-debug") === "1");
    function debug(...args) {
      if (NAV_DEBUG) console.log("[NavBar debug]", ...args);
    }
    // expose a helper for interactive inspection from console
    try {
      if (typeof window !== "undefined") window.__navBarDebug = { NAV_DEBUG };
    } catch (e) {}
    // Language
    const langBtn = document.getElementById("lang-toggle");
    const langMenu = document.getElementById("lang-menu");
    if (langBtn && langMenu) {
      langBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        langMenu.classList.toggle("hidden");
      });
      langMenu.querySelectorAll("button[data-lang]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          setLanguage(btn.getAttribute("data-lang"));
          langMenu.classList.add("hidden");
        });
      });
      document.addEventListener("click", (e) => {
        if (!langBtn.contains(e.target) && !langMenu.contains(e.target)) {
          langMenu.classList.add("hidden");
        }
      });
    }
    // Header scroll behavior
    const header = document.getElementById("site-header");
    const textTargets = header
      ? header.querySelectorAll("a, h2, .liquid-glass-btn")
      : [];

    function applyTextColor(scrolled) {
      textTargets.forEach((el) => {
        const before = window.getComputedStyle
          ? window.getComputedStyle(el).color
          : null;
        if (scrolled) {
          // use dark text in light mode when scrolled (force)
          try {
            el.style.setProperty("color", "#0b1220", "important");
          } catch (e) {
            el.style.color = "#0b1220";
          }
          el.classList.remove("text-white");
          el.classList.add("text-neutral-900");
        } else {
          // not scrolled -> default: white text (force)
          try {
            el.style.setProperty("color", "#ffffff", "important");
          } catch (e) {
            el.style.color = "#ffffff";
          }
          el.classList.remove("text-neutral-900", "text-black");
          el.classList.add("text-white");
        }
        const after = window.getComputedStyle
          ? window.getComputedStyle(el).color
          : null;
        debug("el", el, {
          before,
          after,
          inlineStyle: el.style.getPropertyValue("color"),
          classes: el.className,
        });
      });
    }

    function onScroll() {
      if (!header) return;
      const scrolled = window.scrollY > 20;
      header.classList.toggle("scrolled", scrolled);
      header.classList.toggle("max-w-[950px]", scrolled);
      header.classList.toggle("ml-auto", scrolled);
      header.classList.toggle("mr-auto", scrolled);
      applyTextColor(scrolled);
    }

    // Update on load and on scroll
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    // Observe mutations on the header in case some other code toggles the class
    if (header && window.MutationObserver) {
      const mo = new MutationObserver((mutations) => {
        for (const m of mutations) {
          if (m.type === "attributes" && m.attributeName === "class") {
            const has = header.classList.contains("scrolled");
            debug("MutationObserver detected class change, has scrolled:", has);
            applyTextColor(has);
          }
        }
      });
      mo.observe(header, { attributes: true, attributeFilter: ["class"] });
    }

    // Observe style changes on each text target to detect who/when overwrites color
    if (textTargets.length && window.MutationObserver) {
      textTargets.forEach((el) => {
        try {
          const smo = new MutationObserver((mutations) => {
            for (const m of mutations) {
              if (m.type === "attributes" && m.attributeName === "style") {
                const now = new Date().toISOString();
                const comp = window.getComputedStyle
                  ? window.getComputedStyle(el).color
                  : null;
                debug("Style mutation on", el.tagName, "at", now, {
                  inline: el.getAttribute("style"),
                  computed: comp,
                  classes: el.className,
                });
              }
            }
          });
          smo.observe(el, { attributes: true, attributeFilter: ["style"] });
        } catch (e) {
          debug("failed to observe style for", el, e);
        }
      });
    }

    // If theme changes elsewhere, refresh the text colors (some layouts may dispatch this)
    document.addEventListener("theme-changed", () =>
      applyTextColor(window.scrollY > 20)
    );
  });
</script>
