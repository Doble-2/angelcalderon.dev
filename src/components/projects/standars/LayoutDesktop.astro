---
import { ExternalLinkIcon } from "lucide-react";
import TechnologyTag from "../../index/projects/TechnologyTag";
import Section from "../../share/Section.astro";
import ProjectGalleryDesktop from "./ProjectGalleryDesktop.jsx";
import translations from "../../../i18n";
import { resolveLangFromRequest } from "../../../lib/lang";

const { projectProp } = Astro.props as { projectProp: any };
const lang = resolveLangFromRequest(Astro.request);
const tI18n = (key: string) => translations[lang]?.[key] || key;
const localSrc = (s: string) =>
  s ? (s.startsWith("http") ? s : s.startsWith("/") ? s : "/" + s) : "";

const images = (projectProp?.images ?? []) as string[];
const front = (projectProp?.front ?? []) as string[];
const back = (projectProp?.back ?? []) as string[];
const t = (projectProp?.tech ?? {}) as any;
const techAll = Array.from(
  new Set(
    [
      ...((t?.primary ?? []) as string[]),
      ...((t?.frontend ?? []) as string[]),
      ...((t?.backend ?? []) as string[]),
      ...((t?.mobile ?? []) as string[]),
      ...((t?.infra ?? []) as string[]),
      ...((t?.tools ?? []) as string[]),
      ...((t?.services ?? []) as string[]),
      ...front,
      ...back,
    ].filter(Boolean)
  )
);
---

<Section className={" min-h-screen"}>
  <div class="max-w-7xl mx-auto px-6 md:py-12">
    <div class="grid grid-cols-12 gap-8 items-start">
      <!-- Left: Interactive Gallery Island -->
      <div class="col-span-8">
        <ProjectGalleryDesktop
          client:only="react"
          images={images.map((img: string) =>
            localSrc(
              "/projects/" +
                encodeURIComponent(String(projectProp.slug || projectProp.name)) +
                "/" +
                encodeURIComponent(img),
            )
          )}
          name={projectProp.name}
        />
      </div>

      <!-- Right: Details -->
      <aside class="col-span-4 sticky top-24">
        <h1 class="type-h1 mb-4">{projectProp.name}</h1>
        <p class="type-body text-muted-foreground mb-4">{projectProp.desc}</p>

        <div class="mb-4">
          <h4 class="type-meta font-semibold text-muted-foreground mb-2">
            {tI18n('technologies')}
          </h4>
          <div class="flex flex-wrap gap-2">
            {techAll.map((tech: string) => <TechnologyTag tech={tech} />)}
          </div>
        </div>

        <div class="flex gap-3 mb-6">
          {
            projectProp.url && (
              <>
                <a
                  href={projectProp.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary btn-sm"
                  title={tI18n('view_deployment')}
                >
                  {tI18n('deployment')}
                  <ExternalLinkIcon className="w-4 h-4" />
                </a>
              
              </>
            )
          }
          {
            projectProp.repo && (
              <a
                href={projectProp.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-brand-github btn-sm"
                aria-label={tI18n('view_code_github')}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.744.083-.729.083-.729 1.205.085 1.84 1.236 1.84 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.468-2.381 1.236-3.221-.124-.303-.536-1.523.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 013.003-.404c1.02.005 2.045.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.655 1.653.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.37.814 1.102.814 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                </svg>
                <span class="hidden sm:inline">{tI18n('code')}</span>
              </a>
            )
          }
        </div>

        <div class="text-sm text-muted-foreground">
          <p>
            <strong>{tI18n('period')}:</strong>
            {projectProp.dateStart} — {projectProp.dateEnd}
          </p>
          {
            projectProp.role && (
              <p>
                <strong>{tI18n('role')}:</strong> {projectProp.role}
              </p>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</Section>
