---
import Section from "../../share/Section.astro";
import { Icon } from "astro-icon/components";
import ProjectGalleryMobile from "./ProjectGalleryMobile.jsx";

const { projectProp } = Astro.props;

import "photoswipe/style.css";
import TechnologyTag from "../../index/projects/TechnologyTag";
import { ExternalLinkIcon } from "lucide-react";

const localSrc = (s) => s ? (s.startsWith('http') ? s : s.startsWith('/') ? s : '/' + s) : '';

// Configurar e inicializar Photoswipe
---

<Section className={"min-h-screen justify-start max-w-screen max-w-[100vw !important] pb-10 pt-6"}>
    <div class="max-w-3xl mx-auto px-4 space-y-4">
        <!-- Galería interactiva island -->
        <ProjectGalleryMobile
          client:only="react"
          images={projectProp.images.map(img => localSrc('/projects/' + projectProp.name + '/' + img))}
          name={projectProp.name}
        />

        <!-- Title & description -->
        <div class="space-y-2">
            <h1 class="text-2xl font-bold">{projectProp.name}</h1>
            <p class="text-muted-foreground">{projectProp.desc}</p>
        </div>

        <!-- Tech icons -->
        <div class="flex gap-3 items-center">
             {
              projectProp.front &&
                projectProp.front.map((f) => <TechnologyTag tech={f} />)
            }
            {
              projectProp.back &&
                projectProp.back.map((b) => <TechnologyTag tech={b} />)
            }
        </div>

        <!-- Meta & CTAs -->
        <div class="flex items-center justify-between mt-2">
            <div class="text-sm text-muted-foreground">
                <div>{projectProp.dateStart} — {projectProp.dateEnd}</div>
                {projectProp.role && <div>Rol: {projectProp.role}</div>}
            </div>

            <div class="flex flex-col gap-2 justify-end items-end">
            {
            projectProp.url && (
              <>
                <a
                  href={projectProp.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex  text-sm items-center gap-2 bg-blue-500 text-white font-semibold py-2 px-4 rounded-lg shadow-sm hover:bg-blue-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-white focus-visible:ring-blue-500 transition"
                  title="Ver despliegue"
                >
                  Despliegue
                  <ExternalLinkIcon className="w-4 h-4" />
                </a>
              
              </>
            )
          }
          {
            projectProp.repo && (
              <a
                href={projectProp.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-white ml-4"
              >
                <button
                  class="bg-[#24292f] text-white py-3 px-4 rounded-lg flex items-center gap-3 text-sm"
                  aria-label="GitHub profile"
                  type="button"
                >
                 
                  <span class="hidden sm:inline">Código</span>
                   <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.744.083-.729.083-.729 1.205.085 1.84 1.236 1.84 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.468-2.381 1.236-3.221-.124-.303-.536-1.523.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 013.003-.404c1.02.005 2.045.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.655 1.653.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.37.814 1.102.814 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                  </svg>
                </button>
              </a>
            )
          }
            </div>
        </div>
    </div>
</Section>
<script>
    import PhotoSwipeLightbox from "photoswipe/lightbox";
    const lightbox = new PhotoSwipeLightbox({
        gallery: "#my-slider",
        children: "a",
        pswpModule: () => import("photoswipe"),
    });
    lightbox.init();
    // Core de Swiper y estilos
    import Swiper from "swiper";
    import "swiper/css";
    // Módulo Navigation de Swiper y estilos
    import { Navigation } from "swiper/modules";
    import "swiper/css/navigation";

    // Configurar Swiper
    const swiper = new Swiper(".swiper", {
        modules: [Navigation], // definir los módulos a usar
        loop: true, // definir si los slides estarán en bucle
        slidesPerView: 1, // agregar número de slides para la pantalla
        spaceBetween: 0, // separación entre slides en px
        navigation: {
            // definir botones next y prev para el módulo Navigation
            prevEl: ".swiper-button-prev",
            nextEl: ".swiper-button-next",
        },
    });
</script>
