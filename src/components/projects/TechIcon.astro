---
interface Props {
  kind: string;
}

const { kind } = Astro.props as Props;
const k = String(kind || "").toLowerCase();
const common = "w-4 h-4 opacity-80";
---

{(k.includes("security") || k.includes("osint") || k.includes("cyber")) ? (
  <svg class={common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M12 3l7 4v6c0 5-3 8-7 8s-7-3-7-8V7l7-4z" />
    <path d="M9.5 12l1.7 1.7 3.8-3.8" opacity="0.9" />
  </svg>
) : (k.includes("postgres") || k.includes("redis") || k.includes("sql")) ? (
  <svg class={common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <ellipse cx="12" cy="6" rx="7" ry="3" />
    <path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6" />
    <path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" opacity="0.8" />
  </svg>
) : (k.includes("ai") || k.includes("rag") || k.includes("openai") || k.includes("deepseek")) ? (
  <svg class={common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M12 3v3M12 18v3M3 12h3M18 12h3" />
    <path d="M8 8l-2-2M18 18l-2-2M16 8l2-2M6 18l2-2" opacity="0.8" />
    <circle cx="12" cy="12" r="4" />
  </svg>
) : (k.includes("flutter") || k.includes("react native") || k.includes("mobile")) ? (
  <svg class={common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <rect x="7" y="3" width="10" height="18" rx="2" />
    <path d="M10 6h4" opacity="0.7" />
  </svg>
) : (k.includes("linux") || k.includes("cli") || k.includes("python")) ? (
  <svg class={common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M4 5h16v14H4z" opacity="0.35" />
    <path d="M7 9h10M7 12h6M7 15h8" />
  </svg>
) : (
  <svg class={common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M8 9l-3 3 3 3" />
    <path d="M16 9l3 3-3 3" />
    <path d="M10 20l4-16" opacity="0.6" />
  </svg>
)}
