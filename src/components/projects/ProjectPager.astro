---
import { projects } from "../../data/projects";

type Props = {
  currentSlug: string;
  wrap?: boolean;
};

const { currentSlug, wrap = true } = Astro.props as Props;

const t = (key: "prev" | "next" | "browse" | "all") => {
  const dict = {
    prev: "Previous",
    next: "Next",
    browse: "Browse",
    all: "View all",
  } as const;

  return dict[key];
};

const ordered = [...projects].sort((a, b) => b.order - a.order);
const idx = ordered.findIndex((p) => p.slug === currentSlug);

const safeProject = (i: number) => (i >= 0 && i < ordered.length ? ordered[i] : null);

const prev =
  idx === -1
    ? null
    : idx > 0
      ? safeProject(idx - 1)
      : wrap
        ? safeProject(ordered.length - 1)
        : null;

const next =
  idx === -1
    ? null
    : idx < ordered.length - 1
      ? safeProject(idx + 1)
      : wrap
        ? safeProject(0)
        : null;
---

{prev || next ? (
  <nav class="mt-12" aria-label="Project navigation">
    <div class="flex items-center justify-between gap-4 mb-4">
      <h2 class="type-h3">{t("browse")}</h2>
      <a class="btn btn-ghost btn-sm" href="/projects">
        {t("all")}
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {prev ? (
        <a
          href={`/projects/${encodeURIComponent(String(prev.slug))}`}
          class="group neomorphic block overflow-hidden rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 ring-offset-white"
          aria-label={`${t("prev")}: ${prev?.name}`}
        >
          <div class="flex items-stretch">
            <div class="w-28 sm:w-32 shrink-0 relative">
              <img
                src={(prev?.images && prev.images[0]) || "/rect1-optimized.webp"}
                alt={prev?.name}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/25 to-transparent" />
            </div>

            <div class="flex-1 min-w-0 p-4 sm:p-5">
              <div class="text-[11px] uppercase tracking-wider text-muted-foreground font-semibold">{t("prev")}</div>
              <div class="mt-1 text-base sm:text-lg font-extrabold tracking-tight text-foreground truncate">{prev?.name}</div>
              {prev?.subtitle ? (
                <div class="mt-1 text-sm text-muted-foreground line-clamp-2">{prev.subtitle}</div>
              ) : null}
            </div>
          </div>
        </a>
      ) : (
        <div />
      )}

      {next ? (
        <a
          href={`/projects/${encodeURIComponent(String(next.slug))}`}
          class="group neomorphic block overflow-hidden rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 ring-offset-white"
          aria-label={`${t("next")}: ${next?.name}`}
        >
          <div class="flex items-stretch">
            <div class="w-28 sm:w-32 shrink-0 relative">
              <img
                src={(next?.images && next.images[0]) || "/rect1-optimized.webp"}
                alt={next?.name}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/25 to-transparent" />
            </div>

            <div class="flex-1 min-w-0 p-4 sm:p-5">
              <div class="text-[11px] uppercase tracking-wider text-muted-foreground font-semibold">{t("next")}</div>
              <div class="mt-1 text-base sm:text-lg font-extrabold tracking-tight text-foreground truncate">{next?.name}</div>
              {next?.subtitle ? (
                <div class="mt-1 text-sm text-muted-foreground line-clamp-2">{next.subtitle}</div>
              ) : null}
            </div>
          </div>
        </a>
      ) : (
        <div />
      )}
    </div>
  </nav>
) : null}
