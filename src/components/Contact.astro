---
import translations from "../i18n";

interface Props {
  lang: string;
  t: (key: string) => string;
}
const { lang = 'es', t = (k: string) => k } = Astro.props as Props;

// Solo las cadenas que usa contact.client.js, no el diccionario completo.
const CLIENT_KEYS = ['copied', 'copyError', 'sending', 'success', 'sendError', 'networkError', 'tooManyRequests', 'invalidEmail', 'contact_required'];
const dict = (translations as Record<string, Record<string, string>>)[lang] ?? {};
const clientI18n = Object.fromEntries(CLIENT_KEYS.map((k) => [k, dict[k] ?? k]));

const WHATSAPP = "https://wa.me/584241922882?text=Hola%20acabo%20de%20ver%20tu%20portfolio%20y%20me%20encantar%C3%ADa%20ponerme%20en%20contacto%20contigo";

const intents = ["project", "job", "collab", "other"].map((k) => ({ value: k, label: t(`contact_intent_${k}`) }));

const channels = [
  { label: "WhatsApp", value: t("contact_whatsapp_value"), href: WHATSAPP },
  { label: "LinkedIn", value: "in/angeld2", href: "https://www.linkedin.com/in/angeld2/" },
  { label: "GitHub", value: "Doble-2", href: "https://github.com/Doble-2" },
];
---

<!-- Cierre de la página: vuelve la escena del Ávila, como en el hero -->
<section id="contacto" aria-label={t("contact")} class="contact-scene relative overflow-hidden">
  <img
    src="/hero/avila-1280.webp"
    srcset="/hero/avila-1280.webp 1280w, /hero/avila-2560.webp 2560w"
    sizes="100vw"
    alt=""
    loading="lazy"
    decoding="async"
    class="contact-scene__bg"
  />

  <div class="container-page relative py-24 md:py-36">
    <div class="container-content">
      <h2 class="contact-title">{t("contact_title")}</h2>
      <p class="mt-6 flex items-center gap-2 text-white/75">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_12px] shadow-emerald-400/70"></span>
        {t("contact_reply")}
      </p>

      <div class="mt-14 grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Formulario conversacional: una pregunta a la vez (sin JS se ve completo) -->
        <form id="contact-form" class="contact-card lg:col-span-7" novalidate>
          <div class="hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="subject" id="subject" />

          <div class="contact-progress" aria-hidden="true"><span></span></div>

          <!-- Paso 1: intención -->
          <fieldset class="contact-step" data-step="1">
            <legend class="contact-q"><span class="contact-n">01</span>{t("contact_step1")}</legend>
            <div class="mt-6 flex flex-wrap gap-3">
              {intents.map((i) => (
                <label class="contact-chip">
                  <input type="radio" name="intent" value={i.label} class="sr-only" />
                  <span>{i.label}</span>
                </label>
              ))}
            </div>
            <div class="contact-nav">
              <span></span>
              <button type="button" class="btn btn-secondary" data-next>{t("contact_next")} →</button>
            </div>
          </fieldset>

          <!-- Paso 2: el mensaje -->
          <fieldset class="contact-step" data-step="2">
            <legend class="contact-q"><span class="contact-n">02</span><label for="message">{t("contact_step2")}</label></legend>
            <textarea id="message" name="message" rows="4" maxlength="5000" required placeholder={t("contact_step2_ph")} class="contact-input mt-4 resize-none"></textarea>
            <div class="contact-nav">
              <button type="button" class="btn-link text-white/60" data-prev>← {t("contact_back")}</button>
              <button type="button" class="btn btn-secondary" data-next>{t("contact_next")} →</button>
            </div>
          </fieldset>

          <!-- Paso 3: cómo responder -->
          <fieldset class="contact-step" data-step="3">
            <legend class="contact-q"><span class="contact-n">03</span>{t("contact_step3")}</legend>
            <div class="mt-4 grid gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class="text-sm text-muted-foreground">{t("name")}</label>
                <input id="name" name="name" maxlength="100" required autocomplete="name" placeholder={t("namePlaceholder")} class="contact-input" />
              </div>
              <div>
                <label for="email" class="text-sm text-muted-foreground">{t("email")}</label>
                <input id="email" name="email" type="email" maxlength="254" required autocomplete="email" placeholder={t("emailPlaceholder")} class="contact-input" />
              </div>
            </div>
            <div class="contact-nav">
              <button type="button" class="btn-link text-white/60" data-prev>← {t("contact_back")}</button>
              <button type="submit" id="submit-btn" class="btn btn-primary h-12 px-7 text-base">
                {t("send")}
                <svg id="send-icon" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
              </button>
            </div>
          </fieldset>

          <!-- Enviado -->
          <div class="contact-done" data-done hidden>
            <p class="font-display uppercase text-5xl md:text-7xl leading-[0.9]">{t("contact_done_title")}</p>
            <p class="mt-4 text-lg text-white/75">{t("contact_done_text")}</p>
            <button type="button" class="btn-link mt-8 text-white/70" data-restart>{t("contact_again")}</button>
          </div>

          <p id="form-status" aria-live="polite" class="mt-4 min-h-[1.25rem] text-sm text-muted-foreground"></p>
        </form>

        <!-- Canales directos -->
        <div class="lg:col-span-5">
          <div class="flex justify-center mb-8">
            <canvas id="contact-globe" width="200" height="200" aria-hidden="true" class="rounded-full" style="background:transparent;"></canvas>
          </div>
          <p class="type-meta text-muted-foreground">{t("contact_channels")}</p>
          <ul class="mt-4 divide-y divide-white/10 border-y border-white/10">
            <li>
              <div class="contact-row">
                <a href="mailto:angel@angelcalderon.dev" class="min-w-0 flex-1">
                  <span class="block text-sm text-muted-foreground">Email</span>
                  <span class="block truncate text-xl md:text-2xl font-semibold text-white">angel@angelcalderon.dev</span>
                </a>
                <button type="button" id="copy-email" class="icon-btn icon-btn-ghost shrink-0" title={t("copyEmail")} aria-label={t("copyEmail")}>
                  <svg id="copy-icon" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                </button>
              </div>
            </li>
            {channels.map((c) => (
              <li>
                <a href={c.href} target="_blank" rel="noopener noreferrer" class="contact-row group">
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm text-muted-foreground">{c.label}</span>
                    <span class="block truncate text-xl md:text-2xl font-semibold text-white">{c.value}</span>
                  </span>
                  <span class="text-2xl text-white/40 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-[#f48fb1]" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ clientI18n }}>
  window.__CONTACT_I18N__ = clientI18n;
</script>

<script is:inline src="/contact.client.js" type="module"></script>

<script>
  // Interactive wireframe globe with Caracas marker
  (() => {
    const canvas = document.getElementById("contact-globe") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const W = canvas.width;
    const H = canvas.height;
    const CX = W / 2;
    const CY = H / 2;
    const R = 88; // sphere radius
    const LAT_STEP = 30; // degrees between latitude lines
    const LON_STEP = 30; // degrees between longitude lines
    const DOT_R = 1.4;

    // Caracas: 10.48°N, 66.9°W
    const CARACAS_LAT = 10.48 * (Math.PI / 180);
    const CARACAS_LON = -66.9 * (Math.PI / 180);

    const toRad = (d: number) => d * (Math.PI / 180);

    function project(lat: number, lon: number, rotation: number): [number, number, number] {
      const adjustedLon = lon + rotation;
      const x = R * Math.cos(lat) * Math.sin(adjustedLon);
      const y = -R * Math.sin(lat);
      const z = R * Math.cos(lat) * Math.cos(adjustedLon);
      return [CX + x, CY + y, z];
    }

    function draw(rotation: number) {
      ctx.clearRect(0, 0, W, H);

      // Outer circle
      ctx.beginPath();
      ctx.arc(CX, CY, R, 0, Math.PI * 2);
      ctx.strokeStyle = "rgba(255,255,255,0.08)";
      ctx.lineWidth = 1;
      ctx.stroke();

      // Latitude lines + dots
      for (let lat = -90 + LAT_STEP; lat < 90; lat += LAT_STEP) {
        const latR = toRad(lat);
        ctx.beginPath();
        let first = true;
        for (let lon = -180; lon <= 180; lon += 3) {
          const lonR = toRad(lon);
          const [px, py, pz] = project(latR, lonR, rotation);
          if (pz < 0) { first = true; continue; }
          if (first) { ctx.moveTo(px, py); first = false; }
          else ctx.lineTo(px, py);
        }
        ctx.strokeStyle = "rgba(255,255,255,0.07)";
        ctx.lineWidth = 0.6;
        ctx.stroke();

        // Dots at intersections
        for (let lon = -180; lon < 180; lon += LON_STEP) {
          const lonR = toRad(lon);
          const [px, py, pz] = project(latR, lonR, rotation);
          if (pz < 0) continue;
          const alpha = 0.15 + 0.2 * (pz / R);
          ctx.beginPath();
          ctx.arc(px, py, DOT_R, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255,255,255,${alpha})`;
          ctx.fill();
        }
      }

      // Longitude lines
      for (let lon = -180; lon < 180; lon += LON_STEP) {
        const lonR = toRad(lon);
        ctx.beginPath();
        let first = true;
        for (let lat = -90; lat <= 90; lat += 3) {
          const latR = toRad(lat);
          const [px, py, pz] = project(latR, lonR, rotation);
          if (pz < 0) { first = true; continue; }
          if (first) { ctx.moveTo(px, py); first = false; }
          else ctx.lineTo(px, py);
        }
        ctx.strokeStyle = "rgba(255,255,255,0.07)";
        ctx.lineWidth = 0.6;
        ctx.stroke();
      }

      // Caracas marker
      const [cx, cy, cz] = project(CARACAS_LAT, CARACAS_LON, rotation);
      if (cz > 0) {
        // Outer glow
        const gradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, 14);
        gradient.addColorStop(0, "rgba(128,0,32,0.55)");
        gradient.addColorStop(0.5, "rgba(128,0,32,0.15)");
        gradient.addColorStop(1, "rgba(128,0,32,0)");
        ctx.beginPath();
        ctx.arc(cx, cy, 14, 0, Math.PI * 2);
        ctx.fillStyle = gradient;
        ctx.fill();

        // Core dot
        ctx.beginPath();
        ctx.arc(cx, cy, 3, 0, Math.PI * 2);
        ctx.fillStyle = "#fff";
        ctx.fill();

        // Ring
        ctx.beginPath();
        ctx.arc(cx, cy, 5.5, 0, Math.PI * 2);
        ctx.strokeStyle = "rgba(128,0,32,0.8)";
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }
    }

    if (reducedMotion) {
      draw(0);
    } else {
      let angle = 0;
      const speed = 0.003;
      let animId = 0;

      const tick = () => {
        angle += speed;
        draw(angle);
        animId = requestAnimationFrame(tick);
      };

      // Only animate when visible
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            if (!animId) animId = requestAnimationFrame(tick);
          } else {
            if (animId) { cancelAnimationFrame(animId); animId = 0; }
          }
        },
        { threshold: 0.1 }
      );
      observer.observe(canvas);
    }
  })();
</script>
