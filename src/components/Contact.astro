---
import { Icon } from "astro-icon/components";
import { SendIcon } from "lucide-react";
---

<section id="contacto" class="max-w-xl min-w-[600px] mx-auto px-6 py-12">
  <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6">
    <div class="text-center">
      <h3 class="text-2xl font-semibold">Hablemos</h3>
    
    </div>

    <div class="mt-6">
      <form id="contact-form" class="space-y-3">
        <div>
          <label
            for="name"
            class="block text-sm font-medium text-muted-foreground"
            >Nombre</label
          >
          <input
            placeholder="Tu nombre"
            id="name"
            name="name"
            required
            class="mt-1 w-full bg-transparent border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent/30"
          />
        </div>

        <div>
          <label
            for="email"
            class="block text-sm font-medium text-muted-foreground">Email</label
          >
          <input
            placeholder="tu@correo.com"
            id="email"
            name="email"
            type="email"
            required
            class="mt-1 w-full bg-transparent border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent/30"
          />
        </div>

        <div>
          <label
            for="message"
            class="block text-sm font-medium text-muted-foreground"
            >Mensaje</label
          >
          <textarea
            placeholder="Escribe tu mensaje..."
            id="message"
            name="message"
            rows="4"
            required
            class="mt-1 w-full bg-transparent border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent/30"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-3">
          <button
            type="submit"
            id="submit-btn"
            aria-live="polite"
            class="inline-flex bg-blue-600 items-center gap-2 px-4 py-2 rounded-md font-medium text-white transform transition duration-150 active:scale-95 active:brightness-90 focus:outline-none focus:ring-2 focus:ring-accent/30"
          >
            <!-- send icon -->
            <SendIcon id="send-icon" className="w-4 h-4" />
            <span class="sr-only">Enviar</span>
          </button>

          <button
            type="button"
            id="copy-email"
            class="inline-flex items-center justify-center w-9 h-9 rounded-md text-muted-foreground hover:bg-gray-100 transition transform active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent/30"
            aria-label="Copiar email"
            title="Copiar email"
          >
            <!-- clipboard icon -->
            <svg
              id="copy-icon"
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"
              ></rect><path
                d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path></svg
            >
          </button>
        </div>

        <div
          aria-live="polite"
          id="form-status"
          class="text-sm mt-2 text-muted-foreground text-center min-h-[20px] leading-5 transition-colors"
        >
        </div>
      </form>
    </div>
  </div>
</section>

<script type="module">
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");
  const submitBtn = document.getElementById("submit-btn");
  const copyBtn = document.getElementById("copy-email");

  function showTempCheck(iconEl) {
    if (!iconEl) return;
    const original = iconEl.innerHTML;
    iconEl.innerHTML =
      '<svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>';
    iconEl.classList.add("scale-95");
    setTimeout(() => {
      iconEl.innerHTML = original;
      iconEl.classList.remove("scale-95");
    }, 1500);
  }

  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText("hola@angelcalderon.dev");
      status.textContent = "Email copiado al portapapeles";
      status.classList.remove("text-red-500");
      status.classList.add("text-green-600");
      // animate icon
      const copyIcon = document.getElementById("copy-icon");
      if (copyIcon) {
        copyIcon.classList.add("scale-90");
      }
    } catch (e) {
      status.textContent = "No se pudo copiar. Usa el enlace de Email.";
      status.classList.remove("text-green-600");
      status.classList.add("text-red-500");
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    status.textContent = "Enviando...";
    status.classList.remove("text-red-500", "text-green-600");

    const data = {
      name: form.name.value,
      email: form.email.value,
      message: form.message.value,
    };

    try {
      // button press animation
      submitBtn.classList.add("scale-95");
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        status.textContent = "Gracias — tu mensaje fue enviado.";
        status.classList.add("text-green-600");
        form.reset();
        // show check on send icon
        const sendIcon = document.getElementById("send-icon");
        showTempCheck(sendIcon);
      } else {
        const json = await res.json().catch(() => ({}));
        status.textContent =
          json?.error || "No fue posible enviar. Usa el email directo.";
        status.classList.add("text-red-500");
      }
    } catch (err) {
      status.textContent = "Error de red. Usa el email directo.";
      status.classList.add("text-red-500");
    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove("scale-95");
    }
  });
</script>
