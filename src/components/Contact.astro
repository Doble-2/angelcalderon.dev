---
import { Icon } from "astro-icon/components";
import { SendIcon } from "lucide-react";
import i18n from "../i18n";

interface Props {
  lang: string;
  t: (key: string) => string;
}
const { lang = 'es', t = (k) => k } = Astro.props;
---

<section id="contacto" class="max-w-xl md:min-w-[600px] mx-auto px-4 py-12">
  <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6">
    <div class="text-center">
    <h3 class="text-2xl font-semibold">{t('title')}</h3>
    
    </div>

    <div class="mt-6">
      <form id="contact-form" class="space-y-3">
        <div>
         
            <label
              for="name"
              class="block text-sm font-medium text-muted-foreground"
              >{t('name')}</label
            >
       
            <input
              placeholder={t('namePlaceholder')}
              id="name"
              name="name"
              required
              class="mt-1 w-full bg-transparent border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent/30"
            />
        </div>

        <div>
   
            <label
              for="email"
              class="block text-sm font-medium text-muted-foreground">{t('email')}</label
            >
        
            <input
              placeholder={t('emailPlaceholder')}
              id="email"
              name="email"
              type="email"
              required
              class="mt-1 w-full bg-transparent border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent/30"
            />
        </div>

        <div>
       
            <label
              for="message"
              class="block text-sm font-medium text-muted-foreground"
              >{t('message')}</label
            >
    
            <textarea
              placeholder={t('messagePlaceholder')}
              id="message"
              name="message"
              rows="4"
              required
              class="mt-1 w-full bg-transparent border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent/30"
            ></textarea>
        </div>

        <div class="flex items-center justify-end gap-3">
          <button
            type="submit"
            id="submit-btn"
            aria-live="polite"
            class="inline-flex bg-blue-600 items-center gap-2 px-4 py-2 rounded-md font-medium text-white transform transition duration-150 active:scale-95 active:brightness-90 focus:outline-none focus:ring-2 focus:ring-accent/30"
          >
            <!-- send icon -->
            <SendIcon id="send-icon" className="w-4 h-4" />
         
              <span class="sr-only">{t('send')}</span>
          </button>

          <button
            type="button"
            id="copy-email"
            class="inline-flex items-center justify-center w-9 h-9 rounded-md text-muted-foreground hover:bg-gray-100 transition transform active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent/30"
            aria-label={t('copyEmail')}
            title={t('copyEmail')}
          >
            <!-- clipboard icon -->
            <svg
              id="copy-icon"
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"
              ></rect><path
                d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path></svg
            >
          </button>
        </div>

        <div
          aria-live="polite"
          id="form-status"
          class="text-sm mt-2 text-muted-foreground text-center min-h-[20px] leading-5 transition-colors"
        >
        </div>
      </form>
    </div>
  </div>
</section>



<script src="/src/components/contact.client.js" type="module"></script>
