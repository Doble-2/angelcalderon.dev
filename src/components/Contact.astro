---
import { SendIcon } from "lucide-react";
import i18n from "../i18n";

interface Props {
  lang: string;
  t: (key: string) => string;
}
const { lang = 'es', t = (k: string) => k } = Astro.props as Props;
---

<div id="contacto" class="container-content">
  <div class="theme-light text-foreground bg-background rounded-2xl shadow-md border border-border p-6 md:p-8 max-w-2xl mx-auto">
    <div class="text-center">
    <h3 class="type-h3">{t('title')}</h3>
    
    </div>

    <div class="mt-6">
      <form id="contact-form" class="space-y-4">
        <div>
         
            <label
              for="name"
              class="block text-sm font-medium text-muted-foreground"
              >{t('name')}</label
            >
       
            <input
              placeholder={t('namePlaceholder')}
              id="name"
              name="name"
              required
              class="mt-1 w-full bg-muted/40 text-foreground placeholder:text-muted-foreground border border-border px-3 py-2 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-white"
            />
        </div>

        <div>
   
            <label
              for="email"
              class="block text-sm font-medium text-muted-foreground">{t('email')}</label
            >
        
            <input
              placeholder={t('emailPlaceholder')}
              id="email"
              name="email"
              type="email"
              required
              class="mt-1 w-full bg-muted/40 text-foreground placeholder:text-muted-foreground border border-border px-3 py-2 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-white"
            />
        </div>

        <div>
       
            <label
              for="message"
              class="block text-sm font-medium text-muted-foreground"
              >{t('message')}</label
            >
    
            <textarea
              placeholder={t('messagePlaceholder')}
              id="message"
              name="message"
              rows="4"
              required
              class="mt-1 w-full bg-muted/40 text-foreground placeholder:text-muted-foreground border border-border px-3 py-2 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-white"
            ></textarea>
        </div>

        <div class="flex items-center justify-end gap-3">
          <button
            type="submit"
            id="submit-btn"
            aria-live="polite"
            class="icon-btn icon-btn-primary"
          >
            <!-- send icon -->
            <SendIcon id="send-icon" className="w-4 h-4" />
         
              <span class="sr-only">{t('send')}</span>
          </button>

          <button
            type="button"
            id="copy-email"
            class="icon-btn icon-btn-ghost"
            aria-label={t('copyEmail')}
            title={t('copyEmail')}
          >
            <!-- clipboard icon -->
            <svg
              id="copy-icon"
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"
              ></rect><path
                d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path></svg
            >
          </button>
        </div>

        <div
          aria-live="polite"
          id="form-status"
          class="text-sm mt-2 text-muted-foreground text-center min-h-[20px] leading-5 transition-colors"
        >
        </div>
      </form>
    </div>
  </div>
</div>


<script is:inline define:vars={{ i18n, lang }}>
  window.__I18N__ = i18n;
  window.__LANG__ = lang;
</script>



<script is:inline src="/contact.client.js" type="module"></script>
