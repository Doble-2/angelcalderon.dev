---
import Contact from "../components/Contact.astro";
import NavBar from "../components/share/NavBar.astro";
import Rainy from "../components/share/Rainy.astro";
import translations from "../i18n";
import SpeedInsights from "@vercel/speed-insights/astro";
import { onMount } from "solid-js";
import { initializeApp } from "firebase/app";
import { getAnalytics } from "firebase/analytics";
import Footer from "../components/share/footer.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	url?: string;
}

const {
  title = 'Angel Calderon - Desarrollador Web/Mobile',
  description = 'Angel Calderon - Desarrollador Web/Mobile freelance en Caracas, Venezuela. Experto en Flutter, React, Next.js y Python. Portfolio profesional para reclutadores y clientes.',
  image = '/profile.png',
  url = Astro.request.url || '/'
} = Astro.props;
const firebaseConfig = {
	apiKey: "YOUR_API_KEY",
	authDomain: "YOUR_AUTH_DOMAIN",
	projectId: "YOUR_PROJECT_ID",
	storageBucket: "YOUR_STORAGE_BUCKET",
	messagingSenderId: "YOUR_MESSAGING_SENDER_ID",
	appId: "YOUR_APP_ID",
	measurementId: "YOUR_MEASUREMENT_ID",
};

// Idioma determinado en el servidor mediante cookie o Accept-Language
let lang: string = 'es';
const cookieHeader = Astro.request.headers.get('cookie') || '';
const match = cookieHeader.match(/(?:^|;\s*)lang=([^;]+)/);
if (match) { try { lang = decodeURIComponent(match[1]); } catch {} }
else {
	const accept = Astro.request.headers.get('accept-language') || '';
	if (accept.toLowerCase().startsWith('en')) lang = 'en';
}
if (!['es','en'].includes(lang)) lang = 'es';
const t = (key: string) => translations[lang]?.[key] || key;

onMount(() => {
	const app = initializeApp(firebaseConfig);
	getAnalytics(app);
});
---

