---
import "../styles/global.css";
import NavBar from "../components/share/NavBar.astro";
import translations from "../i18n";
import { resolveLangFromRequest } from "../lib/lang";
import SpeedInsights from "@vercel/speed-insights/astro";
import Footer from "../components/share/footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  lang?: "es" | "en";
  robots?: string;
}

const {
  title = "Ángel Calderón — Software Architect & AI Engineer",
  description = "Arquitecto de software e ingeniero de IA. Desarrollo productos web y mobile con foco en performance, UX, seguridad y despliegue. Python, Next.js, React Native, Flutter, RAG y sistemas IoT.",
  image = "/og.jpg",
  url = Astro.url?.toString() || "/",
  lang: forcedLang,
  robots = "index, follow",
} = Astro.props;

// Idioma determinado en el servidor mediante cookie o Accept-Language
const lang = resolveLangFromRequest(Astro.request, forcedLang);
const t = (key: string) => translations[lang]?.[key] || key;

const SITE = (Astro.site?.toString() || "https://angelcalderon.dev").replace(/\/$/, "");
const locale = lang === "en" ? "en_US" : "es_ES";
const alternateLocale = lang === "en" ? "es_ES" : "en_US";

const keywords = lang === "en"
  ? "Ángel Calderón, software architect, AI engineer, AI agents, RAG, OSINT, cybersecurity, IoT, Python, FastAPI, Next.js, React, React Native, Flutter, TypeScript, PostgreSQL, Redis, Docker, Vercel, AWS, Figma, performance, UX, Caracas, Venezuela"
  : "Ángel Calderón, arquitecto de software, ingeniero de IA, agentes de IA, RAG, OSINT, ciberseguridad, IoT, Python, FastAPI, Next.js, React, React Native, Flutter, TypeScript, PostgreSQL, Redis, Docker, Vercel, AWS, Figma, performance, UX, Caracas, Venezuela";

const canonicalUrl = (() => {
  try {
    const u = new URL(String(url), SITE);
    return new URL(u.pathname, SITE).toString();
  } catch {
    return new URL("/", SITE).toString();
  }
})();

const imageUrl = (() => {
  try {
    return new URL(String(image), SITE).toString();
  } catch {
    return new URL("/og.jpg", SITE).toString();
  }
})();

const alternateEs = new URL("/", SITE).toString();
const alternateEn = new URL("/en", SITE).toString();

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ángel Calderón",
  url: SITE,
  image: `${SITE}/og.jpg`,
  description: lang === "en"
    ? "Software Architect & AI Engineer based in Caracas, Venezuela. Building web & mobile products with Python, Next.js, React Native, Flutter, RAG and IoT."
    : "Arquitecto de Software e Ingeniero de IA en Caracas, Venezuela. Desarrollo productos web y mobile con Python, Next.js, React Native, Flutter, RAG e IoT.",
  sameAs: [
    "https://github.com/Doble-2",
    "https://www.linkedin.com/in/angeld2/",
    "https://x.com/angelcaldev",
  ],
  jobTitle: "Software Architect & AI Engineer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Caracas",
    addressCountry: "VE",
  },
  knowsAbout: [
    "Python",
    "AI Agents",
    "RAG",
    "Cybersecurity",
    "OSINT",
    "IoT",
    "FastAPI",
    "Next.js",
    "React",
    "React Native",
    "Flutter",
    "TypeScript",
    "PostgreSQL",
    "Redis",
    "Docker",
    "Vercel",
    "AWS",
    "Figma",
  ],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "angelcalderon.dev",
  url: SITE,
  inLanguage: lang,
};
---

<!doctype html>
<html lang={lang} data-current-lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content={keywords}
    />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <meta name="author" content="Ángel Calderón" />
    <meta name="geo.placename" content="Caracas, Venezuela" />
    <meta name="geo.region" content="VE" />
    <meta name="geo.position" content="10.4806;-66.9036" />
    <meta name="ICBM" content="10.4806, -66.9036" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={lang === "en" ? "Ángel Calderón — Software Architect & AI Engineer" : "Ángel Calderón — Arquitecto de Software e Ingeniero de IA"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Ángel Calderón" />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@angelcaldev" />
    <meta name="twitter:creator" content="@angelcaldev" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="author" href={`${SITE}/llms.txt`} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0c0e14" />

    <!-- Fuentes: Inter (texto) + Anton (titulares) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&family=Anton&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- JSON-LD structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </head>
  <body class="max-w-screen bg-background text-foreground">
    <a href="#main-content" class="sr-only focus:not-sr-only">{lang === "en" ? "Skip to content" : "Saltar al contenido"}</a>

    <NavBar lang={lang} t={t} />
    <main id="main-content" class="relative text-foreground">
      <slot />
    </main>
    <Footer lang={lang} />
    <SpeedInsights />
  </body>
</html>
<script is:inline>
  // IntersectionObserver fallback for .reveal (browsers without scroll-driven animations)
  if (!CSS.supports('animation-timeline: view()')) {
    const style = document.createElement('style');
    style.textContent = `
      .reveal {
        opacity: 0;
        transform: translateY(48px) scale(0.97);
        transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
                    transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .reveal.is-visible {
        opacity: 1;
        transform: none;
      }
    `;
    document.head.appendChild(style);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  }
</script>
<script is:inline>
  // Force light theme (site-wide)
  document.documentElement.classList.remove("dark");
  document.documentElement.setAttribute("data-theme", "light");

  // Brillo de las tarjetas que sigue al cursor (solo con ratón)
  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    document.addEventListener(
      "pointermove",
      (e) => {
        const card = e.target instanceof Element && e.target.closest(".card, .neomorphic");
        if (!card) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - r.left}px`);
        card.style.setProperty("--my", `${e.clientY - r.top}px`);
      },
      { passive: true },
    );
  }
</script>
