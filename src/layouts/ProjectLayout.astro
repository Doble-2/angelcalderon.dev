---
import Layout from "./Layout.astro";
import type { Project } from "../data/projects";
import TechIcon from "../components/projects/TechIcon.astro";
import ProjectPager from "../components/projects/ProjectPager.astro";

interface Props {
  project: Project;
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const { project } = Astro.props as Props;

const safeUrl = (u: unknown) => {
  if (!u) return null;
  const s = String(u).trim();
  if (!s || s === "#") return null;
  return s;
};

const demoUrl = safeUrl(project.links?.demo || (project as any).url || null);
const repoUrl = safeUrl(project.links?.repo || (project as any).repo || null);

const images = (project.images || []).filter(Boolean);
const heroImage = images[0] || "/rect1-optimized.webp";
const gallery = images.slice(1);

const truncate = (str: string, n: number = 170) =>
  str && str.length > n ? `${str.slice(0, n).trim()}...` : str;

const pageTitle =
  (Astro.props as Props).title ||
  `${project.name} | Angel Calderon — Software Architect & AI Engineer`;

const pageDescription =
  (Astro.props as Props).description || truncate(project.description || "", 180);

const pageImage = (Astro.props as Props).image || heroImage;
const pageUrl = (Astro.props as Props).url || Astro.request.url;

const primary = project.tech?.primary ?? [];
const tools = project.tech?.tools ?? [];
const t = (project.tech ?? {}) as any;
const fullStack = Array.from(
  new Set(
    [
      ...primary,
      ...(t?.frontend ?? []),
      ...(t?.backend ?? []),
      ...(t?.mobile ?? []),
      ...(t?.infra ?? []),
      ...(t?.services ?? []),
      ...tools,
    ].filter(Boolean)
  )
);

---

<Layout title={pageTitle} description={pageDescription} image={pageImage} url={pageUrl}>
  <main class="container-content pt-20 md:pt-14 px-3 py-10 md:py-14">
    <header class="max-w-4xl">
      <h1 class="type-display bg-gradient-to-r from-blue-300 via-blue-600 to-purple-500 bg-clip-text text-transparent">
        {project.name}
      </h1>
      {project.subtitle ? (
        <p class="mt-3 type-lead text-muted-foreground max-w-3xl">{project.subtitle}</p>
      ) : null}

      <!-- Mobile quick facts (glance) -->
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 lg:hidden">
        {project.role ? (
          <div class="rounded-2xl neomorphic p-4">
            <div class="text-xs text-muted-foreground">Role</div>
            <div class="mt-1 text-sm font-semibold text-foreground">{project.role}</div>
          </div>
        ) : null}

        {project.dateStart ? (
          <div class="rounded-2xl neomorphic p-4">
            <div class="text-xs text-muted-foreground">Date</div>
            <div class="mt-1 text-sm font-semibold text-foreground">{project.dateStart}</div>
          </div>
        ) : null}

        {Array.isArray(project.metrics) && project.metrics.length ? (
          <div class="rounded-2xl neomorphic p-4 sm:col-span-2">
            <div class="text-xs text-muted-foreground">Highlights</div>
            <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2">
              {project.metrics.slice(0, 4).map((m) => (
                <div class="rounded-xl border border-border bg-muted p-3">
                  <div class="text-xs text-muted-foreground">{m.label}</div>
                  <div class="mt-1 text-sm font-semibold text-foreground">{m.value}</div>
                </div>
              ))}
            </div>
          </div>
        ) : null}

        {fullStack.length ? (
          <div class="rounded-2xl neomorphic p-4 sm:col-span-2">
            <div class="text-xs text-muted-foreground">Stack</div>
            <div class="mt-2 flex flex-wrap gap-2">
              {fullStack.slice(0, 14).map((t) => (
                <span class="chip inline-flex items-center gap-2">
                  <TechIcon kind={t} />
                  <span>{t}</span>
                </span>
              ))}
            </div>
          </div>
        ) : null}
      </div>

      <div class="mt-5 hidden lg:flex flex-wrap gap-2">
        {primary.map((t) => (
          <span class="chip inline-flex items-center gap-2">
            <TechIcon kind={t} />
            <span>{t}</span>
          </span>
        ))}
      </div>

      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        {demoUrl ? (
          <a
            href={demoUrl}
            class="btn btn-primary w-full sm:w-auto justify-center"
            target={demoUrl.startsWith("/") ? undefined : "_blank"}
            rel={demoUrl.startsWith("/") ? undefined : "noopener noreferrer"}
          >
            Demo
          </a>
        ) : null}
        {repoUrl ? (
          <a
            href={repoUrl}
            class="btn btn-brand-github w-full sm:w-auto justify-center"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.744.083-.729.083-.729 1.205.085 1.84 1.236 1.84 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.468-2.381 1.236-3.221-.124-.303-.536-1.523.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 013.003-.404c1.02.005 2.045.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.655 1.653.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.37.814 1.102.814 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
            <span>Repo</span>
          </a>
        ) : null}
      </div>
    </header>

    <section class="mt-10 grid lg:grid-cols-12 gap-6 md:gap-8 items-start">
      <!-- 65/35: 8/4 columns -->
      <div class="lg:col-span-8 order-2 lg:order-1">
        <div class="space-y-4">
          <div class="overflow-hidden rounded-2xl neomorphic">
            <img
              src={heroImage}
              alt={`${project.name} hero`}
              class="w-full h-auto object-cover"
              loading="eager"
              decoding="async"
            />
          </div>

          {gallery.length ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {gallery.map((src, idx) => (
                <div class="overflow-hidden rounded-2xl neomorphic">
                  <img
                    src={src}
                    alt={`${project.name} gallery ${idx + 1}`}
                    class="w-full h-full object-cover aspect-[4/3]"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))}
            </div>
          ) : null}
        </div>
      </div>

      <aside class="hidden lg:block lg:col-span-4 order-1 lg:order-2">
        <div class="lg:sticky lg:top-24 space-y-4">
          <div class="rounded-2xl neomorphic p-5 md:p-6">
            <h2 class="type-h3">Project Info</h2>

            <dl class="mt-4 grid gap-4">
              <div>
                <dt class="text-sm text-muted-foreground">Role</dt>
                <dd class="mt-1 text-sm text-foreground opacity-90">{project.role}</dd>
              </div>

              <div>
                <dt class="text-sm text-muted-foreground">Date</dt>
                <dd class="mt-1 text-sm text-foreground opacity-90">{project.dateStart}</dd>
              </div>

              {fullStack.length ? (
                <div>
                  <dt class="text-sm text-muted-foreground">Stack</dt>
                  <dd class="mt-2 flex flex-wrap gap-2">
                    {fullStack.map((t) => (
                      <span class="chip inline-flex items-center gap-2">
                        <TechIcon kind={t} />
                        <span>{t}</span>
                      </span>
                    ))}
                  </dd>
                </div>
              ) : null}

              <div>
                <dt class="text-sm text-muted-foreground">Description</dt>
                <dd class="mt-2 text-sm text-foreground opacity-90 leading-relaxed">
                  {project.description}
                </dd>
              </div>
            </dl>
          </div>

          {Array.isArray(project.metrics) && project.metrics.length ? (
            <div class="rounded-2xl neomorphic p-5 md:p-6">
              <h3 class="text-sm font-semibold text-foreground">Metrics</h3>
              <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                {project.metrics.slice(0, 4).map((m) => (
                  <div class="rounded-xl border border-border bg-muted p-3">
                    <div class="text-xs text-muted-foreground">{m.label}</div>
                    <div class="mt-1 text-sm text-foreground opacity-90 font-semibold">{m.value}</div>
                  </div>
                ))}
              </div>
            </div>
          ) : null}
        </div>
      </aside>
    </section>

    <ProjectPager currentSlug={project.slug} />
  </main>
</Layout>
