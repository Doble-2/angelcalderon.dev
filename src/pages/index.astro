---
import ExperienceSection from "../components/index/experience/ExperienceSection.astro";
import ProfileSection from "../components/index/ProfileSection.astro";
import ProjectSection from "../components/index/projects/ProjectSection.astro";
import CertifiedSection from "../components/index/certifieds/CertifiedSection.astro";
import Section from "../components/share/Section.astro";
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";
import translations from "../i18n";
let lang: string = 'es';
const cookieHeader = Astro.request.headers.get('cookie') || '';
const match = cookieHeader.match(/(?:^|;\s*)lang=([^;]+)/);
if (match) { try { lang = decodeURIComponent(match[1]); } catch {} }
else {
  const accept = Astro.request.headers.get('accept-language') || '';
  if (accept.toLowerCase().startsWith('en')) lang = 'en';
}
if (!['es','en'].includes(lang)) lang='es';
const t = (key: string) => translations[lang]?.[key] || key;
---
<Layout title="Ángel Calderón | Desarrollador Frontend">
  <Section className={"pt-8 md:justify-between bg-transparent"}>
    <ProfileSection lang={lang} t={t} />
  </Section>

  <Section className={" py-8"}>
    <ExperienceSection lang={lang} t={t} />
  </Section>

 <!-- <Section className={" p-0 px-0"}>
    <ProjectSection lang={lang} t={t} /> 
  </Section>-->

  <!-- <Section className={" py-8 flex-col flex md:flex-row"}>
    <CertifiedSection lang={lang} t={t} /> 
  </Section>-->
</Layout>
