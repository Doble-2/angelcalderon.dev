---
import ExperienceSection from "../components/index/experience/ExperienceSection.astro";
import ProfileSection from "../components/index/ProfileSection.astro";
import ProjectSection from "../components/index/projects/ProjectSection.astro";
import CertifiedSection from "../components/index/certifieds/CertifiedSection.astro";
import AboutSection from "../components/index/about/AboutSection.astro";
import Section from "../components/share/Section.astro";
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";
import translations from "../i18n";
import { resolveLangFromRequest } from "../lib/lang";

// `/` es siempre la versión en español (coherente con canonical/hreflang).
// Si el visitante prefiere inglés (cookie o Accept-Language), lo enviamos a `/en`.
Astro.response.headers.set("Vary", "Cookie, Accept-Language");
if (resolveLangFromRequest(Astro.request) === "en") {
  return Astro.redirect("/en", 302);
}

const lang = "es" as const;
const t = (key: string) => translations[lang]?.[key] || key;
---

<Layout
  lang={lang}
  title="Ángel Calderón — Software Architect & AI Engineer"
  description="Arquitecto de software e ingeniero de IA. Creo productos web y mobile con foco en performance, UX, seguridad y despliegue: Python, Next.js, React Native, Flutter, RAG, IoT y agentes de IA."
>
  <ProfileSection lang={lang} t={t} />
  <ProjectSection lang={lang} t={t} />

  <Section id="sobre-mi" ariaLabel="Sobre mí">
    <AboutSection lang={lang} t={t} />
  </Section>

  <Section id="experiencia" ariaLabel="Experiencia">
    <ExperienceSection lang={lang} t={t} />
  </Section>

  <Section id="certificados" ariaLabel="Certificados">
    <CertifiedSection lang={lang} t={t} />
  </Section>

  <Contact lang={lang} t={t} />
</Layout>
