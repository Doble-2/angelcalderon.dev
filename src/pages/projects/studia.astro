---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { projects } from "../../data/projects";

const project = projects.find((p) => p.slug === "studia");
if (!project) return Astro.redirect("/404");

// RAG explicado como una suma
const formula = [
  { title: "School data", text: "Policies · guides · curriculum" },
  { title: "Student question", text: "WhatsApp · mobile · web" },
  { title: "Personal answer", text: "Grounded · context-aware · safe" },
];

const channels = [
  { kicker: "Web", title: "Admin dashboard", text: "Manage institutions, upload knowledge, track cohorts and engagement." },
  { kicker: "Mobile", title: "Student app", text: "A native tutoring experience built for focus: chat, quizzes and progress." },
  { kicker: "WhatsApp", title: "Instant access", text: "Students reach the tutor where they already are, via Cloud API." },
];

const phones = [
  { src: "/projects/studia/chatbot.webp", label: "Chat" },
  { src: "/projects/studia/quizes.webp", label: "Quiz" },
  { src: "/projects/studia/themes.webp", label: "Themes" },
];

const gallery = ["/projects/studia/dashboardadmin.webp", "/projects/studia/dashboardowner.webp", "/projects/studia/light-dark.webp"];
---

<ProjectLayout project={project} gallery={gallery} title={`${project.name} — AI tutor with RAG | Ángel Calderón`}>
  <!-- RAG en una línea -->
  <section class="container-page pb-20 md:pb-28">
    <div class="container-content">
      <h2 class="type-h2">RAG that feels personal</h2>
      <div class="mt-10 grid items-stretch gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr]">
        {formula.map((f, i) => (
          <>
            <div class={`card reveal p-6 ${i === 2 ? "border-[#c2185b]/50 bg-[#800020]/20" : ""}`}>
              <h3 class="text-xl font-semibold text-white">{f.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{f.text}</p>
            </div>
            {i < 2 && (
              <span class="grid place-items-center font-display text-5xl text-white/30" aria-hidden="true">{i === 0 ? "+" : "="}</span>
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- Omnicanal -->
  <section class="container-page pb-20 md:pb-28">
    <div class="container-content">
      <h2 class="type-h2">One brain, three channels</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {channels.map((c) => (
          <article class="card reveal p-6 md:p-8">
            <span class="tag">{c.kicker}</span>
            <h3 class="mt-5 text-xl font-semibold text-white">{c.title}</h3>
            <p class="mt-2 text-muted-foreground">{c.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- App móvil: tres pantallas en fila -->
  <section class="container-page pb-20 md:pb-28">
    <div class="container-content">
      <h2 class="type-h2">The mobile app</h2>
      <div class="mt-10 grid grid-cols-3 gap-3 md:gap-8">
        {phones.map((p, i) => (
          <figure class={`reveal ${i === 1 ? "md:-mt-8" : ""}`}>
            <button type="button" class="block w-full overflow-hidden rounded-[22px] border border-white/10 shadow-2xl shadow-black/60" data-zoom={p.src} aria-label={`Studia — ${p.label}`}>
              <img src={p.src} alt={`Studia — ${p.label}`} class="w-full h-auto" loading="lazy" decoding="async" />
            </button>
            <figcaption class="mt-3 text-center text-sm text-muted-foreground">{p.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</ProjectLayout>
