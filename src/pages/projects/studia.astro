---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
import ProjectPager from "../../components/projects/ProjectPager.astro";

const project = projects.find((p) => p.slug === "studia");
if (!project) return Astro.redirect("/404");

const img = {
	dashboard: "/projects/studia/dashboardadmin.webp",
	mobile: "/projects/studia/mobile-flow.webp",
	mobileAlt: "/projects/studia/light-dark.webp",
    chatbot: "/projects/studia/chatbot.webp",
    quizes: "/projects/studia/quizes.webp",
    themes: "/projects/studia/themes.webp",
};

const techBadges = [
	"React Native",
	"WhatsApp Cloud API",
	"Vector DB",
	"Python",
];
---

<Layout
	title={`${project.name}: AI-Powered Tutor | Angel Calderon — EdTech & RAG`}
	description={project.description}
	image={img.dashboard}
	url={Astro.request.url}
>
	<main class="container-content pt-20 md:pt-14 px-3 py-10 md:py-14">
		<!-- Hero: Omnichannel + Personalization -->
		<section class="relative overflow-hidden rounded-3xl border border-border bg-background">
			<div class="absolute inset-0 opacity-80" style="background: radial-gradient(900px 520px at 15% 15%, rgba(99,102,241,0.28), transparent 60%);" />
			<div class="absolute inset-0 opacity-80" style="background: radial-gradient(900px 520px at 85% 25%, rgba(168,85,247,0.22), transparent 60%);" />
			<div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(85, 85, 85, 0.55), rgba(46, 46, 46, 0.92));" />

			<div class="relative grid lg:grid-cols-12 gap-8 p-6 md:p-10 items-center">
				<div class="lg:col-span-6">
					<div class="flex flex-wrap gap-2">
						<span class="chip">EdTech</span>
						<span class="chip">Omnichannel</span>
						<span class="chip">RAG</span>
					</div>

					<h1 class="mt-5 type-display bg-gradient-to-r from-indigo-600 via-violet-600 to-fuchsia-600 bg-clip-text text-transparent">
						Studia: AI-Powered Tutor
					</h1>
					<p class="mt-3 type-lead text-muted-foreground max-w-xl">
						Web admin + mobile app + WhatsApp access — powered by retrieval-augmented generation for hyper-personalized learning.
					</p>

					<div class="mt-6 flex flex-col sm:flex-row gap-3">
						<a class="btn btn-primary w-full sm:w-auto justify-center" href="/#contact">
							Contact
						</a>
						<a class="btn btn-secondary w-full sm:w-auto justify-center" href="/projects">
							See more projects
						</a>
					</div>

					<p class="mt-6 text-sm text-muted-foreground max-w-xl">
						{project.description}
					</p>

					<div class="mt-6 flex flex-wrap gap-2">
						{techBadges.map((t) => (
							<span class="chip">{t}</span>
						))}
					</div>
				</div>

				<div class="lg:col-span-6">
					<div class="relative device-stage">
						<!-- Laptop -->
						<div class="device-laptop">
							<div class="device-laptop__top">
								<div class="device-laptop__camera" aria-hidden="true" />
							</div>
							<div class="device-laptop__screen">
								<img
									src={img.dashboard}
									alt="Studia admin dashboard"
									class="w-full h-full object-cover"
									loading="eager"
									decoding="async"
								/>
							</div>
							<div class="device-laptop__base" aria-hidden="true" />
						</div>

						<!-- iPhone overlay -->
						<div class="device-phone">
							<div class="device-phone__notch" aria-hidden="true" />
							<div class="device-phone__screen">
								<img
									src={img.chatbot}
									alt="Studia mobile / WhatsApp experience"
									class="w-full h-full object-cover"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="device-phone__badge">
								<span class="inline-flex items-center gap-2 rounded-full border border-border bg-muted px-3 py-1 text-xs text-muted-foreground">
									<span class="w-2 h-2 rounded-full bg-emerald-400" aria-hidden="true" />
									WhatsApp + Mobile
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- RAG visual explanation -->
		<section class="mt-10">
			<h2 class="type-h2">RAG that feels personal</h2>
			<p class="mt-2 text-sm text-muted-foreground max-w-3xl">
				Studia connects a school’s institutional knowledge with each student’s questions to produce grounded, hyper-personalized answers.
			</p>

			<div class="mt-6 rounded-3xl neomorphic backdrop-blur-sm p-5 md:p-7">
				<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
					<div class="rag-card">
						<div class="rag-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
								<path d="M14 2v6h6" />
								<path d="M8 13h8" />
								<path d="M8 17h8" />
							</svg>
						</div>
						<div>
							<div class="text-sm font-semibold text-foreground">School Data (PDFs)</div>
							<div class="mt-1 text-xs text-muted-foreground">Policies · Guides · Curriculum</div>
						</div>
					</div>

					<div class="rag-operator" aria-hidden="true">+</div>

					<div class="rag-card">
						<div class="rag-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
								<path d="M7 8h10" />
								<path d="M7 12h6" />
							</svg>
						</div>
						<div>
							<div class="text-sm font-semibold text-foreground">Student Question</div>
							<div class="mt-1 text-xs text-muted-foreground">WhatsApp · Mobile · Web</div>
						</div>
					</div>

					<div class="rag-operator" aria-hidden="true">=</div>

					<div class="rag-card rag-card--result">
						<div class="rag-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 2a7 7 0 0 0-4 12.7V18a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-3.3A7 7 0 0 0 12 2z" />
								<path d="M9 22h6" />
								<path d="M10 19h4" />
							</svg>
						</div>
						<div>
							<div class="text-sm font-semibold text-foreground">Hyper-Personalized Answer</div>
							<div class="mt-1 text-xs text-muted-foreground">Grounded · Context-aware · Safe</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Omnichannel -->
		<section class="mt-10">
			<h2 class="type-h2">Omnichannel by design</h2>
			<p class="mt-2 text-sm text-muted-foreground max-w-3xl">
				A single intelligence layer, delivered wherever the school and students already are.
			</p>

			<div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
				<article class="rounded-3xl border border-border bg-muted p-5">
					<div class="flex items-center gap-3">
						<span class="mono-pill">Web</span>
						<h3 class="text-foreground font-semibold">Admin Dashboard</h3>
					</div>
					<p class="mt-2 text-sm text-muted-foreground">
						Manage institutions, upload knowledge, track cohorts, and measure engagement.
					</p>
				</article>

				<article class="rounded-3xl border border-border bg-muted p-5">
					<div class="flex items-center gap-3">
						<span class="mono-pill">Mobile</span>
						<h3 class="text-foreground font-semibold">Student App</h3>
					</div>
					<p class="mt-2 text-sm text-muted-foreground">
						Native tutoring experience designed for focus: chat, quizzes, and progress.
					</p>
				</article>

				<article class="rounded-3xl border border-border bg-muted p-5">
					<div class="flex items-center gap-3">
						<span class="mono-pill">WhatsApp</span>
						<h3 class="text-foreground font-semibold">Instant Access</h3>
					</div>
					<p class="mt-2 text-sm text-muted-foreground">
						Lower friction by meeting students on WhatsApp using Cloud API workflows.
					</p>
				</article>
			</div>
		</section>

		<!-- Mobile spotlight -->
		<section class="mt-10 rounded-3xl border border-white/10 overflow-hidden">
			<div class="relative p-6 md:p-10 bg-gradient-to-br from-indigo-500/15 via-violet-500/10 to-fuchsia-500/10">
				<div class="absolute inset-0" style="background: radial-gradient(720px 420px at 20% 30%, rgba(99,102,241,0.20), transparent 60%);" />
				<div class="absolute inset-0" style="background: radial-gradient(720px 420px at 85% 10%, rgba(168,85,247,0.18), transparent 60%);" />

				<div class="relative">
					<div class="flex items-center justify-between gap-4 flex-wrap">
						<div>
							<h2 class="type-h2">Mobile Spotlight</h2>
							<p class="mt-2 text-sm text-muted-foreground max-w-2xl">
								Built with React Native to deliver a fast, native tutoring experience.
							</p>
						</div>
						<span class="chip">React Native</span>
					</div>

					<div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
						<div class="phone-shot">
							<div class="phone-shot__label">Chat</div>
							<img src={img.chatbot} alt="Studia mobile chat" class="phone-shot__img" loading="lazy" decoding="async" />
						</div>

						<div class="phone-shot">
							<div class="phone-shot__label">Themes</div>
							<img src={img.themes} alt="Studia light/dark mode" class="phone-shot__img" loading="lazy" decoding="async" />
						</div>

						<div class="phone-shot phone-shot--placeholder" aria-label="Studia quiz screenshot placeholder">
							<div class="phone-shot__label">Quiz</div>
                            <img src={img.quizes} alt="Studia mobile quiz" class="phone-shot__img" loading="lazy" decoding="async" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Tech stack badges -->
		<section class="mt-10">
			<h2 class="type-h2">Tech stack</h2>
			<p class="mt-2 text-sm text-muted-foreground max-w-3xl">
				Built to scale across channels while keeping answers grounded and reliable.
			</p>

			<div class="mt-6 flex flex-wrap gap-2">
				{techBadges.map((t) => (
					<span class="chip">{t}</span>
				))}
			</div>
		</section>
		<ProjectPager currentSlug={project.slug} />
	</main>

	<style>
		.device-stage{position:relative;min-height:420px}

		.device-laptop{position:relative;max-width:560px;margin-left:auto;margin-right:auto;filter:drop-shadow(0 30px 40px rgba(0,0,0,.55))}
			.device-laptop__top{height:22px;border-radius:18px 18px 10px 10px;background:rgb(var(--background) / 0.92);border:1px solid rgb(var(--border) / 0.14);display:flex;align-items:center;justify-content:center}
			.device-laptop__camera{width:6px;height:6px;border-radius:999px;background:rgb(var(--foreground) / 0.22)}
			.device-laptop__screen{aspect-ratio:16/10;overflow:hidden;border-radius:0 0 18px 18px;border:1px solid rgb(var(--border) / 0.14);border-top:none;background:rgb(var(--muted) / 0.8)}
			.device-laptop__base{height:16px;border-radius:0 0 22px 22px;background:linear-gradient(90deg, rgb(var(--muted) / 0.95), rgb(var(--muted) / 0.65));border:1px solid rgb(var(--border) / 0.12);border-top:none}

			.device-phone{position:absolute;right:6%;bottom:-6%;width:min(220px,46%);border-radius:28px;border:1px solid rgb(var(--border) / 0.14);background:rgb(var(--background) / 0.88);backdrop-filter:blur(10px);box-shadow:0 24px 40px rgba(0,0,0,.18)}
			.device-phone__notch{position:absolute;top:10px;left:50%;transform:translateX(-50%);width:44%;height:18px;border-radius:0 0 14px 14px;background:rgb(var(--foreground) / 0.10);border:1px solid rgb(var(--border) / 0.10)}
		.device-phone__screen{aspect-ratio:9/19;overflow:hidden;border-radius:26px}
		.device-phone__badge{position:absolute;left:12px;bottom:12px}

			.rag-card{display:flex;align-items:center;gap:12px;border-radius:18px;border:1px solid rgb(var(--border) / 0.14);background:rgb(var(--background) / 0.8);padding:14px 14px;flex:1}
			.rag-card--result{background:linear-gradient(135deg, rgba(99,102,241,.14), rgba(168,85,247,.12));border-color:rgb(var(--border) / 0.16)}
			.rag-icon{width:40px;height:40px;border-radius:14px;display:flex;align-items:center;justify-content:center;color:rgb(var(--foreground) / 0.9);background:rgb(var(--muted) / 0.8);border:1px solid rgb(var(--border) / 0.12)}
			.rag-operator{width:40px;height:40px;border-radius:999px;display:flex;align-items:center;justify-content:center;color:rgb(var(--muted-foreground));background:rgb(var(--muted) / 0.8);border:1px solid rgb(var(--border) / 0.12);font-weight:700}

			.mono-pill{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;border:1px solid rgb(var(--border) / 0.14);background:rgb(var(--muted) / 0.8);padding:2px 10px;font-size:12px;color:rgb(var(--muted-foreground))}

			.phone-shot{position:relative;border-radius:26px;border:1px solid rgb(var(--border) / 0.14);background:rgb(var(--background) / 0.92);overflow:hidden;box-shadow:0 18px 32px rgba(0,0,0,.14)}
			.phone-shot__label{position:absolute;top:10px;left:10px;z-index:2;font-size:12px;color:rgb(var(--muted-foreground));background:rgb(var(--background) / 0.75);border:1px solid rgb(var(--border) / 0.12);padding:4px 10px;border-radius:999px;backdrop-filter:blur(8px)}
		.phone-shot__img{width:100%;height:auto;display:block;object-fit:cover;aspect-ratio:9/19}
		.phone-shot--placeholder{aspect-ratio:9/19}
			.phone-shot__placeholder{width:100%;height:100%;padding:18px;display:flex;flex-direction:column;justify-content:center;background:linear-gradient(160deg, rgba(99,102,241,.14), rgba(168,85,247,.10), rgba(236,72,153,.08))}

			@media (max-width: 640px){
				.device-stage{min-height:420px}
				.device-phone{right:auto;left:62%;transform:translateX(-50%);bottom:-12%;width:min(210px,54%)}
			}
			@media (max-width: 420px){
				.device-stage{min-height:400px}
				.device-phone{left:56%;bottom:-14%;width:min(196px,58%)}
			}
	</style>
</Layout>
