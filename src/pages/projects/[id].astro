---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import LayoutMobile from "../../components/projects/standars/LayoutMobile.astro";
import LayoutDesktop from "../../components/projects/standars/LayoutDesktop.astro";

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/404");
}

const entries = await getCollection("projects");
const entry = entries.find((e) => e.id === id || e.data.name === id) || null;
const project = entry ? ({ id: entry.id, ...entry.data } as any) : null;

if (!project) {
  return Astro.redirect("/404");
}
// valores por defecto seguros
const cover = (project.images && project.images[0]) || "/rect1-optimized.webp";
const description = (project.description || "").trim();
const tech = Array.from(new Set([...(project.front || []), ...((project.back || []) ?? [])].filter(Boolean)));
const images = project.images || [];
const liveUrl = project.url || null;
const repoUrl = project.repo || null;
// helper para normalizar rutas de imagen (si viene 'home.webp' -> '/home.webp')
const localSrc = (s) => s ? (s.startsWith('http') ? s : s.startsWith('/') ? s : '/' + s) : '';

// Metadatos dinámicos para SEO/Redes
const truncate = (str, n = 150) => (str && str.length > n ? str.slice(0, n).trim().replace(/[,\s]+[^,\s]+$/, '...') : str);
const pageTitle = `${project.name} | Angel Calderon - Desarrollador Web/Mobile`;
const pageDescription = truncate(description || `Proyecto ${project.name} desarrollado por Angel Calderon usando ${((tech || []).slice(0,4)).join(', ')}.` , 160);
const pageImage = localSrc(cover);
const pageUrl = Astro.request?.url || `/projects/${encodeURIComponent(id)}`;
---

<Layout title={pageTitle} description={pageDescription} image={pageImage} url={pageUrl}>
  <!-- Mobile -->
  <div class="md:hidden">
    <LayoutMobile projectProp={{ ...project, cover, desc: project.description, description, tech, images, url: liveUrl, repo: repoUrl }} />
  </div>

  <!-- Desktop: use shared LayoutDesktop component -->
  <div class="hidden md:block">
    <LayoutDesktop projectProp={{ ...project, cover, desc: project.description, description, tech, images, url: liveUrl, repo: repoUrl }} />
  </div>

</Layout>

<script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": project.name,
    "headline": project.name,
    "description": pageDescription,
    "image": pageImage,
    "url": pageUrl,
    "author": {
      "@type": "Person",
      "name": "Angel Calderon",
      "url": "https://angelcalderon.dev"
    },
    "datePublished": project.dateStart || undefined,
    "dateModified": project.dateEnd || undefined,
    "keywords": (tech || []).slice(0,10).join(', ')
  })}
</script>
