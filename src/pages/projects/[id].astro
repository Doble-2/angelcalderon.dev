---
import app from "../../firebase/client";
import { getFirestore, getDocs, collection, where, query } from "firebase/firestore";
import Layout from "../../layouts/Layout.astro";
import LayoutMobile from "../../components/projects/standars/LayoutMobile.astro";
import LayoutDesktop from "../../components/projects/standars/LayoutDesktop.astro";

export async function getStaticPaths() {
  return [
    { params: { id: "Born AI" } },
    { params: { id: "Appod" } },
    { params: { id: "Dona tu Vuelto" } },
    { params: { id: "Onbox" } },
  ];
}
const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/404");
}

const db = getFirestore(app);
const q = query(collection(db, "projects"), where("name", "==", id));
const querySnap = await getDocs(q);
const project = querySnap.docs.length > 0 ? querySnap.docs[0].data() : null;

if (!project) {
  return Astro.redirect("/404");
}
// valores por defecto seguros
const cover = project.cover || (project.images && project.images[0]) || "/rect1-optimized.webp";
const description = project.description || project.summary || "";
const tech = project.tech || project.technologies || [];
const images = project.images || (project.gallery && project.gallery.images) || [];
const liveUrl = project.url || project.live || null;
const repoUrl = project.repo || project.repository || null;
// helper para normalizar rutas de imagen (si viene 'home.webp' -> '/home.webp')
const localSrc = (s) => s ? (s.startsWith('http') ? s : s.startsWith('/') ? s : '/' + s) : '';
---

<Layout title={`${project.name} | Ángel Calderón`}>
  <!-- Mobile -->
  <div class="md:hidden">
    <LayoutMobile projectProp={{ ...project, cover, description, tech, images, url: liveUrl, repo: repoUrl }} />
  </div>

  <!-- Desktop: use shared LayoutDesktop component -->
  <div class="hidden md:block">
    <LayoutDesktop projectProp={{ ...project, cover, description, tech, images, url: liveUrl, repo: repoUrl }} />
  </div>

</Layout>
