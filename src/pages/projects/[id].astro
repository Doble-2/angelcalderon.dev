---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

// Tier 1 tiene páginas dedicadas (ruta estática), pero dejamos un guardrail.
const TIER_1 = new Set(["osint-d2", "eficense", "studia"]);

const raw = String(Astro.params.id || "");
let decoded = raw;
try {
  decoded = decodeURIComponent(raw);
} catch {
  decoded = raw;
}

// Si por alguna razón cae aquí un slug Tier 1, redirige a su ruta canónica.
if (TIER_1.has(raw)) {
  return Astro.redirect(`/projects/${raw}`, 301);
}

let project = projects.find((p) => p.slug === raw) || null;

// Back-compat: si alguien entra por /projects/<Project Name>
// redirige al slug canónico.
if (!project) {
  const byName = projects.find(
    (p) => String(p.name).toLowerCase() === String(decoded).toLowerCase(),
  );

  if (byName) {
    return Astro.redirect(`/projects/${byName.slug}`, 301);
  }

  // Devolver 404 real en vez de redirect (evita indexación de /404)
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}
---

{project ? (
  <ProjectLayout project={project} />
) : (
  <Layout lang="es" title="404 — No encontrado" description="Página no encontrada" robots="noindex, nofollow">
    <section class="relative flex min-h-[80vh] flex-col items-center justify-center px-6 text-center">
      <h1 class="font-display text-[10rem] leading-none uppercase sm:text-[14rem]">404</h1>
      <p class="mt-4 text-lg text-white/70 sm:text-xl">Proyecto no encontrado</p>
      <a href="/" class="btn btn-primary mt-8">Volver al inicio</a>
    </section>
  </Layout>
)}
