---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { projects } from "../../data/projects";

// Tier 1 tiene páginas dedicadas (ruta estática), pero dejamos un guardrail.
const TIER_1 = new Set(["osint-d2", "eficense", "studia"]);

const raw = String(Astro.params.id || "");
let decoded = raw;
try {
  decoded = decodeURIComponent(raw);
} catch {
  decoded = raw;
}

// Si por alguna razón cae aquí un slug Tier 1, redirige a su ruta canónica.
if (TIER_1.has(raw)) {
  return Astro.redirect(`/projects/${raw}`, 301);
}

let project = projects.find((p) => p.slug === raw) || null;

// Back-compat: si alguien entra por /projects/<Project Name>
// redirige al slug canónico.
if (!project) {
  const byName = projects.find(
    (p) => String(p.name).toLowerCase() === String(decoded).toLowerCase(),
  );

  if (byName) {
    return Astro.redirect(`/projects/${byName.slug}`, 301);
  }

  return Astro.redirect("/404");
}
---

<ProjectLayout project={project} />
