---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

const project = projects.find((p) => p.slug === "osint-d2");
if (!project) return Astro.redirect("/404");

const hero = project.images?.[0] || "/rect1-optimized.webp";
const evidence = project.images?.[1] || hero;
---

<Layout
  title={`${project.name} | Angel Calderon — Dark Ops OSINT`}
  description={project.description}
  image={evidence}
  url={Astro.request.url}
>
  <main class="container-content py-10 md:py-14">
    <!-- Hero -->
    <section class="relative overflow-hidden rounded-3xl border border-white/10 bg-black">
      <div class="absolute inset-0 opacity-60" style="background: radial-gradient(900px 360px at 20% 0%, rgba(220,38,38,0.25), transparent 60%);" />
      <div class="absolute inset-0 opacity-60" style="background: radial-gradient(900px 360px at 80% 20%, rgba(59,130,246,0.18), transparent 60%);" />

      <div class="relative p-6 md:p-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/80 font-mono">
          <span class="w-2 h-2 rounded-full bg-red-500" />
          <span>dark-ops://project</span>
        </div>

        <h1 class="mt-5 font-mono text-3xl md:text-5xl font-bold text-white tracking-tight">
          <span class="text-white/70">$</span> {project.name}
        </h1>
        <p class="mt-3 font-mono text-white/70 max-w-3xl">
          AI-Powered Identity Intelligence
        </p>

        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          {project.links?.repo ? (
            <a class="btn btn-secondary w-full sm:w-auto justify-center" href={project.links.repo} target="_blank" rel="noopener noreferrer">
              Repo
            </a>
          ) : null}
        </div>

        <p class="mt-6 text-sm text-white/70 max-w-3xl">
          {project.description}
        </p>
      </div>
    </section>

    <!-- Pipeline -->
    <section class="mt-10">
      <h2 class="type-h2 font-mono">The Pipeline</h2>
      <p class="mt-2 text-sm text-muted-foreground max-w-3xl">
        A deterministic OSINT workflow: collect → normalize → analyze → report.
      </p>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-4 gap-3">
        <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
          <div class="font-mono text-xs text-white/60">Input</div>
          <div class="mt-2 font-mono text-white">Identifiers</div>
          <div class="mt-1 text-xs text-white/60">email · username · phone</div>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
          <div class="font-mono text-xs text-white/60">113+ Sources</div>
          <div class="mt-2 font-mono text-white">Triangulation</div>
          <div class="mt-1 text-xs text-white/60">social · code · breaches</div>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
          <div class="font-mono text-xs text-white/60">DeepSeek AI</div>
          <div class="mt-2 font-mono text-white">OCEAN + OpSec</div>
          <div class="mt-1 text-xs text-white/60">risk surface analysis</div>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
          <div class="font-mono text-xs text-white/60">Output</div>
          <div class="mt-2 font-mono text-white">PDF Report</div>
          <div class="mt-1 text-xs text-white/60">audit-ready dossier</div>
        </div>
      </div>
    </section>

    <!-- Evidence -->
    <section class="mt-10">
      <h2 class="type-h2 font-mono">Evidence</h2>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-7">
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-black/30 shadow-lg shadow-red-900/20">
            <img src={evidence} alt="OSINT PDF report preview" class="w-full h-auto object-cover" loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-white/10 bg-black/25 p-5">
            <h3 class="font-mono text-white">Technical capabilities</h3>
            <ul class="mt-4 space-y-2 text-sm text-white/70">
              <li>• Cross-platform triangulation to reduce false positives.</li>
              <li>• Cognitive profiling (OCEAN) + OpSec vulnerability analysis.</li>
              <li>• Automated PDF dossier generation (WeasyPrint).</li>
              <li>• Async pipeline designed for scale and rate limits.</li>
            </ul>

            <div class="mt-5 flex flex-wrap gap-2">
              {project.tech.primary.map((t) => (
                <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/80 font-mono">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
