---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
import ProjectPager from "../../components/projects/ProjectPager.astro";

const project = projects.find((p) => p.slug === "osint-d2");
if (!project) return Astro.redirect("/404");

const hero = project.images?.[0] || "/rect1-optimized.webp";
const evidence = project.images?.[1] || hero;
---

<Layout
  title={`${project.name} | Angel Calderon — Dark Ops OSINT`}
  description={project.description}
  image={evidence}
  url={Astro.request.url}
>
  <main class="container-content py-10 md:py-14 pt-20 md:pt-14 px-3">
    <!-- Hero -->
    <section class="relative overflow-hidden rounded-3xl border border-border bg-background">
      <div class="absolute inset-0 opacity-60" style="background: radial-gradient(900px 360px at 20% 0%, rgba(220,38,38,0.25), transparent 60%);" />
      <div class="absolute inset-0 opacity-60" style="background: radial-gradient(900px 360px at 80% 20%, rgba(59,130,246,0.18), transparent 60%);" />

      <div class="relative p-6 md:p-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted px-3 py-1 text-xs text-muted-foreground font-mono">
          <span class="w-2 h-2 rounded-full bg-red-500" />
          <span>dark-ops://project</span>
        </div>

        <h1 class="mt-5 font-mono text-3xl md:text-5xl font-bold text-foreground tracking-tight">
          <span class="text-muted-foreground">$</span> {project.name}
        </h1>
        <p class="mt-3 font-mono text-muted-foreground max-w-3xl">
          AI-Powered Identity Intelligence
        </p>

        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          {project.links?.repo ? (
            <a class="btn btn-brand-github w-full sm:w-auto justify-center" href={project.links.repo} target="_blank" rel="noopener noreferrer">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.744.083-.729.083-.729 1.205.085 1.84 1.236 1.84 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.468-2.381 1.236-3.221-.124-.303-.536-1.523.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 013.003-.404c1.02.005 2.045.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.655 1.653.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.37.814 1.102.814 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
              </svg>
              <span>Repo</span>
            </a>
          ) : null}
        </div>

        <p class="mt-6 text-sm text-muted-foreground max-w-3xl">
          {project.description}
        </p>
      </div>
    </section>

    <!-- Pipeline -->
    <section class="mt-10">
      <h2 class="type-h2 font-mono">The Pipeline</h2>
      <p class="mt-2 text-sm text-muted-foreground max-w-3xl">
        A deterministic OSINT workflow: collect → normalize → analyze → report.
      </p>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-4 gap-3">
        <div class="rounded-2xl border border-border bg-muted p-4">
          <div class="font-mono text-xs text-muted-foreground">Input</div>
          <div class="mt-2 font-mono text-foreground">Identifiers</div>
          <div class="mt-1 text-xs text-muted-foreground">email · username · phone</div>
        </div>
        <div class="rounded-2xl border border-border bg-muted p-4">
          <div class="font-mono text-xs text-muted-foreground">113+ Sources</div>
          <div class="mt-2 font-mono text-foreground">Triangulation</div>
          <div class="mt-1 text-xs text-muted-foreground">social · code · breaches</div>
        </div>
        <div class="rounded-2xl border border-border bg-muted p-4">
          <div class="font-mono text-xs text-muted-foreground">DeepSeek AI</div>
          <div class="mt-2 font-mono text-foreground">OCEAN + OpSec</div>
          <div class="mt-1 text-xs text-muted-foreground">risk surface analysis</div>
        </div>
        <div class="rounded-2xl border border-border bg-muted p-4">
          <div class="font-mono text-xs text-muted-foreground">Output</div>
          <div class="mt-2 font-mono text-foreground">PDF Report</div>
          <div class="mt-1 text-xs text-muted-foreground">audit-ready dossier</div>
        </div>
      </div>
    </section>

    <!-- Evidence -->
    <section class="mt-10">
      <h2 class="type-h2 font-mono">Evidence</h2>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-7">
          <div class="overflow-hidden rounded-2xl border border-border bg-background shadow-lg shadow-black/10">
            <img src={evidence} alt="OSINT PDF report preview" class="w-full h-auto object-cover" loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-border bg-muted p-5">
            <h3 class="font-mono text-foreground">Technical capabilities</h3>
            <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
              <li>• Cross-platform triangulation to reduce false positives.</li>
              <li>• Cognitive profiling (OCEAN) + OpSec vulnerability analysis.</li>
              <li>• Automated PDF dossier generation (WeasyPrint).</li>
              <li>• Async pipeline designed for scale and rate limits.</li>
            </ul>

            <div class="mt-5 flex flex-wrap gap-2">
              {project.tech.primary.map((t) => (
                <span class="inline-flex items-center rounded-full border border-border bg-background px-3 py-1 text-xs text-muted-foreground font-mono">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
    <ProjectPager currentSlug={project.slug} />
  </main>
</Layout>
