---
// OSINT-D2 — contenido verificado en el repo (README, src/core/services/agent_prompts.py,
// report_scope.py, adapters). Cifras: 20 escáneres de plataformas + 4 fuentes de email,
// 9 herramientas del agente, 547 tests (pytest --collect-only), 5 idiomas.
// Las dimensiones 3, 5 y 6 del informe solo se generan con --sensitive-inferences.
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { projects } from "../../data/projects";
import { resolveLangFromRequest } from "../../lib/lang";

const project = projects.find((p) => p.slug === "osint-d2");
if (!project) return Astro.redirect("/404");

const lang = resolveLangFromRequest(Astro.request);
const es = lang === "es";

const copy = es
  ? {
      subtitle: "Agente de IA autónomo para investigar identidades",
      metrics: [{ label: "Herramientas del agente", value: "9" }, { label: "Tests", value: "547" }],
      summary: "Le das un usuario o un email y un agente de IA lo investiga solo: busca en más de 20 plataformas, sigue las pistas que encuentra y entrega un dossier PDF basado en evidencia. Open source, con Docker y la opción de correr la IA en local con Ollama.",
      traceKicker: "Investigación real",
      traceTitle: "Así piensa",
      traceLead: "No sigue una lista fija. Encuentra una pista, decide a dónde ir y sigue. Esta es la traza de una investigación sobre «torvalds».",
      tracePoints: ["Encuentra pistas nuevas en cada paso", "Decide solo qué herramienta usar", "Si se queda sin pasos, el motor fuerza el informe: siempre termina en algo concreto"],
      toolsTitle: "9 herramientas, 3 fases",
      profileTitle: "Un informe por dimensiones",
      profileLead: "Cada conclusión se apoya en evidencia recogida durante la investigación.",
      profileDefault: "Siempre",
      profileSensitive: "Solo si lo pides",
      profileSensitiveNote: "Son inferencias sobre personas reales, así que vienen apagadas. Se activan con --sensitive-inferences.",
      anchorsTitle: "Filtra falsos positivos",
      anchorsLead: "Declaras una fuente que sabes que es real (--trust github:usuario) y cada perfil encontrado se puntúa contra ella.",
      anchorsCaption: "Peso de cada señal",
      dossierTitle: "El entregable",
      dossierLead: "Un dossier PDF de estilo clasificado, listo para compartir.",
      deployTitle: "Un comando",
      deployLead: "Dashboard en vivo en localhost:8000. Con Ollama, la IA corre en tu máquina, sin API keys.",
      copy: "Copiar",
      copied: "Copiado",
      ethics: "Diseñado solo para investigación de seguridad autorizada, periodismo y OSINT legítimo.",
    }
  : {
      subtitle: project.subtitle,
      metrics: undefined,
      summary: "Give it a username or an email and an AI agent investigates on its own: it searches 20+ platforms, follows the leads it finds and delivers an evidence-based PDF dossier. Open source, Docker-ready, with the option to run the AI locally via Ollama.",
      traceKicker: "Real investigation",
      traceTitle: "How it thinks",
      traceLead: "No fixed checklist. It finds a lead, decides where to go and keeps going. This is the trace of an investigation into “torvalds”.",
      tracePoints: ["Finds new leads at every step", "Chooses which tool to use on its own", "If it runs out of steps, the engine forces the report: it always ends with something concrete"],
      toolsTitle: "9 tools, 3 phases",
      profileTitle: "A report by dimensions",
      profileLead: "Every conclusion is grounded in evidence gathered during the investigation.",
      profileDefault: "Always",
      profileSensitive: "Only if you ask",
      profileSensitiveNote: "These are inferences about real people, so they are off by default. Turn them on with --sensitive-inferences.",
      anchorsTitle: "Filters false positives",
      anchorsLead: "Declare a source you know is real (--trust github:user) and every profile found is scored against it.",
      anchorsCaption: "Weight of each signal",
      dossierTitle: "The deliverable",
      dossierLead: "A classified-style PDF dossier, ready to share.",
      deployTitle: "One command",
      deployLead: "Live dashboard at localhost:8000. With Ollama, the AI runs on your machine with no API keys.",
      copy: "Copy",
      copied: "Copied",
      ethics: "Built for authorized security research, journalism and legitimate OSINT only.",
    };

// Traza real del README: el agente pivota de usuario → web → emails → informe
const trace = [
  { tool: "scan_username", arg: "torvalds", out: es ? "11 perfiles confirmados de 19" : "11 confirmed of 19 scanned" },
  { tool: "fetch_url", arg: "github.com/torvalds", out: es ? "encuentra emails y redes" : "finds emails and social links" },
  { tool: "scan_email", arg: "torvalds@linux-foundation.org", out: es ? "13 confirmados de 23" : "13 confirmed of 23" },
  { tool: "scan_email", arg: "torvalds@kernel.org", out: es ? "12 confirmados" : "12 confirmed" },
  { tool: "fetch_url", arg: "x.com/torvalds · keybase.io/torvalds", out: es ? "cruza X y Keybase" : "cross-checks X and Keybase" },
  { tool: "generate_report", arg: es ? "perfil final" : "final profile", out: es ? "separa al Torvalds real de los suplantadores" : "tells the real Torvalds from impersonators" },
];

const phases = [
  {
    name: es ? "Buscar" : "Search",
    tools: [
      ["scan_username", es ? "20 plataformas" : "20 platforms"],
      ["scan_email", "Gravatar · PGP"],
      ["scan_phone", es ? "operador · WhatsApp" : "carrier · WhatsApp"],
      ["fetch_url", es ? "con protección SSRF" : "SSRF-protected"],
    ],
  },
  {
    name: es ? "Verificar" : "Verify",
    tools: [
      ["breach_check", "HIBP k-anonymity"],
      ["compare_avatars", es ? "hash perceptual" : "perceptual hash"],
      ["correlate_stylometry", es ? "estilo de escritura" : "writing style"],
      ["search_vector_memory", es ? "BM25 sobre la evidencia" : "BM25 over evidence"],
    ],
  },
  {
    name: es ? "Cerrar" : "Close",
    tools: [["generate_report", es ? "cierra la investigación" : "closes the case"]],
  },
];

// Numeración = encabezados del informe (## 1. … ## 6.)
const dimsDefault = es
  ? [["1", "Identidad", "Nombres, alias y cuentas confirmadas"], ["2", "Geo-temporal", "Dónde y cuándo está activo"], ["4", "Técnico y profesional", "Oficio, lenguajes y herramientas"]]
  : [["1", "Identity", "Names, aliases and confirmed accounts"], ["2", "Geo-temporal", "Where and when they are active"], ["4", "Technical & professional", "Trade, languages and tools"]];
const dimsSensitive = es
  ? [["3", "Psicología (OCEAN)", "Rasgos inferidos de lo que escribe"], ["5", "Ideología y valores", "Temas y posturas públicas"], ["6", "Superficie de ataque", "Lo expuesto que podría usarse en su contra"]]
  : [["3", "Psychology (OCEAN)", "Traits inferred from their writing"], ["5", "Ideology & values", "Public topics and stances"], ["6", "Attack surface", "Exposed data that could be used against them"]];
const dimGroups = [
  { label: copy.profileDefault, dims: dimsDefault, sensitive: false },
  { label: copy.profileSensitive, dims: dimsSensitive, sensitive: true },
];

const weights = [
  { label: es ? "Nombre" : "Name", value: 40, color: "#800020" },
  { label: "Bio", value: 30, color: "#a3154a" },
  { label: "Avatar", value: 20, color: "#c2185b" },
  { label: es ? "Ubicación" : "Location", value: 10, color: "#e0679a" },
];

const dossier = es
  ? ["Ficha de identidad", "Matriz de riesgo", "Grafo de entidades, exportable a JSON, Obsidian Canvas, HTML y PNG"]
  : ["Identity card", "Risk matrix", "Entity graph, exportable to JSON, Obsidian Canvas, HTML and PNG"];

const deployFacts = es
  ? ["DeepSeek · OpenAI · Ollama", "5 idiomas: ES EN PT AR RU", "CLI + dashboard web", "Python 3.11 – 3.13", "Licencia MIT"]
  : ["DeepSeek · OpenAI · Ollama", "5 languages: EN ES PT AR RU", "CLI + web dashboard", "Python 3.11 – 3.13", "MIT license"];

const commands = ["git clone https://github.com/Doble-2/osint-d2 && cd osint-d2", "cp .env.example .env", "docker compose up -d"];
---

<ProjectLayout project={project} gallery={["/projects/osint-d2/dashboard-graph.webp"]} summary={copy.summary} subtitle={copy.subtitle} metrics={copy.metrics} title={`${project.name} — Agentic OSINT | Ángel Calderón`}>
  <!-- 1. Cómo razona el agente: la traza como terminal -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content">
      <p class="type-meta text-[#f48fb1]">{copy.traceKicker}</p>
      <h2 class="mt-5 type-h2">{copy.traceTitle}</h2>
      <p class="mt-5 max-w-2xl text-lg text-white/70">{copy.traceLead}</p>
    </div>
    <div class="container-content mt-10 grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4 lg:pt-4">
        <ul class="space-y-4">
          {copy.tracePoints.map((pt) => (
            <li class="flex gap-3 text-white/80">
              <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c2185b]" aria-hidden="true"></span>{pt}
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal lg:col-span-8 overflow-hidden rounded-2xl border border-white/10 bg-black/50 shadow-2xl shadow-black/60">
        <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-white/15" aria-hidden="true"></span>
          <span class="h-3 w-3 rounded-full bg-white/15" aria-hidden="true"></span>
          <span class="h-3 w-3 rounded-full bg-white/15" aria-hidden="true"></span>
          <span class="ml-3 font-mono text-xs text-white/50">osint-d2 agent · torvalds</span>
        </div>
        <ol class="space-y-5 p-4 font-mono text-[0.8rem] sm:p-5 sm:text-sm md:p-7 md:text-[0.95rem]">
          {trace.map((s, i) => (
            <li class="grid grid-cols-[2rem_1fr] gap-x-2 sm:grid-cols-[2.5rem_1fr] sm:gap-x-3">
              <span class="text-white/35 tabular-nums">{i + 1}/{trace.length}</span>
              <div class="min-w-0">
                <p class="break-words">
                  <span class={i === trace.length - 1 ? "text-[#ff80ab]" : "text-[#f48fb1]"}>{s.tool}</span><span class="inline-block max-w-full break-words"><span class="text-white/40">{"("}</span><span class="text-white">{s.arg}</span><span class="text-white/40">{")"}</span></span>
                </p>
                <p class="mt-1 text-emerald-300/90">✓ {s.out}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 2. Herramientas por fase -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content">
      <h2 class="type-h2">{copy.toolsTitle}</h2>
      <ol class="mt-10 grid gap-4 md:grid-cols-3">
        {phases.map((ph, i) => (
          <li class="card reveal p-5 md:p-6">
            <p class="flex items-baseline gap-3">
              <span class="font-display text-4xl text-[#c2185b]">{i + 1}</span>
              <span class="text-xl font-semibold text-white">{ph.name}</span>
            </p>
            <ul class="mt-5 divide-y divide-white/10">
              {ph.tools.map(([name, desc]) => (
                <li class="py-3">
                  <code class="block break-all font-mono text-sm text-white">{name}</code>
                  <span class="text-sm text-muted-foreground">{desc}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. Dimensiones del informe: 3 siempre, 3 opcionales -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content">
      <h2 class="type-h2">{copy.profileTitle}</h2>
      <p class="mt-5 max-w-2xl text-lg text-white/70">{copy.profileLead}</p>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {dimGroups.map((g) => (
          <div class={`rounded-2xl border p-5 md:p-7 ${g.sensitive ? "border-dashed border-[#c2185b]/50" : "border-white/10 bg-white/[0.02]"}`}>
            <p class="type-meta text-muted-foreground">{g.label}</p>
            <ul class="mt-4 space-y-5">
              {g.dims.map(([n, name, desc]) => (
                <li class="flex gap-4">
                  <span class={`w-6 shrink-0 font-display text-3xl leading-none ${g.sensitive ? "text-white/30" : "text-[#c2185b]"}`}>{n}</span>
                  <span>
                    <span class="block text-lg font-semibold text-white">{name}</span>
                    <span class="text-sm text-muted-foreground">{desc}</span>
                  </span>
                </li>
              ))}
            </ul>
            {g.sensitive && <p class="mt-6 border-t border-white/10 pt-4 text-sm text-white/60">{copy.profileSensitiveNote}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Trust anchors -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="type-h2">{copy.anchorsTitle}</h2>
        <p class="mt-5 text-lg text-white/70">{copy.anchorsLead}</p>

        <p class="mt-10 type-meta text-muted-foreground">{copy.anchorsCaption}</p>
        <div class="mt-3 flex h-4 overflow-hidden rounded-full" role="img" aria-label={weights.map((w) => `${w.label} ${w.value}%`).join(", ")}>
          {weights.map((w) => <div style={`width:${w.value}%;background:${w.color}`}></div>)}
        </div>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-4" aria-hidden="true">
          {weights.map((w) => (
            <li class="flex items-baseline gap-2">
              <span class="h-2.5 w-2.5 shrink-0 rounded-full" style={`background:${w.color}`}></span>
              <span class="text-sm text-white/70">{w.label}</span>
              <span class="font-semibold tabular-nums text-white">{w.value}%</span>
            </li>
          ))}
        </ul>
      </div>
      <button type="button" class="reveal block overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/60" data-zoom="/projects/osint-d2/dashboard-report.webp" aria-label="Trust anchors">
        <img src="/projects/osint-d2/dashboard-report.webp" alt="OSINT-D2 — informe con trust anchors, datos de demostración" class="w-full h-auto" loading="lazy" decoding="async" />
      </button>
    </div>
  </section>

  <!-- 5. Dossier PDF -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content grid items-center gap-12 lg:grid-cols-12">
      <button type="button" class="reveal lg:col-span-5 mx-auto block w-full max-w-sm overflow-hidden rounded-xl border border-white/10 shadow-2xl shadow-black/60 -rotate-2 transition-transform hover:rotate-0" data-zoom="/projects/osint-d2/dossier-demo.webp" aria-label="Dossier PDF">
        <img src="/projects/osint-d2/dossier-demo.webp" alt="OSINT-D2 — PDF dossier" class="w-full h-auto" loading="lazy" decoding="async" />
      </button>
      <div class="lg:col-span-7">
        <h2 class="type-h2">{copy.dossierTitle}</h2>
        <p class="mt-5 text-lg text-white/70">{copy.dossierLead}</p>
        <ul class="mt-8 space-y-4">
          {dossier.map((d) => (
            <li class="flex gap-4 text-lg text-white/85">
              <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c2185b]" aria-hidden="true"></span>
              {d}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. Despliegue -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content">
      <h2 class="type-h2">{copy.deployTitle}</h2>
      <p class="mt-5 max-w-2xl text-lg text-white/70">{copy.deployLead}</p>
      <div class="mt-10 overflow-hidden rounded-2xl border border-white/10 bg-black/50">
        <div class="flex items-center justify-between border-b border-white/10 px-4 py-2.5">
          <span class="font-mono text-xs text-white/50">bash</span>
          <button type="button" class="rounded-md px-3 py-1 text-xs font-semibold text-white/70 hover:bg-white/10 hover:text-white" data-copy={commands.join("\n")} data-copied={copy.copied}>{copy.copy}</button>
        </div>
        <div class="overflow-x-auto p-5 font-mono text-sm leading-relaxed text-white md:p-6 md:text-base">
          {commands.map((c, i) => (
            <p class="whitespace-pre"><span class="select-none text-white/40">$ </span><span class={i === commands.length - 1 ? "text-[#f48fb1]" : ""}>{c}</span></p>
          ))}
        </div>
      </div>
      <ul class="mt-6 flex flex-wrap gap-2">
        {deployFacts.map((f) => <li class="tag px-3 py-1.5 text-sm">{f}</li>)}
      </ul>
      <p class="mt-12 rounded-xl border border-[#800020]/40 bg-[#800020]/10 px-5 py-4 text-sm text-white/75">⚠ {copy.ethics}</p>
    </div>
  </section>
</ProjectLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || "");
        btn.textContent = btn.dataset.copied || "✓";
        setTimeout(() => (btn.textContent = label), 1800);
      } catch { /* sin portapapeles: el texto sigue seleccionable */ }
    });
  });
</script>
