---
// OSINT-D2 — contenido basado en el repo (README, docs/guides/agent-mode.md,
// docs/architecture, CHANGELOG). Cifras verificadas en el código:
// 20 escáneres de plataformas + 4 fuentes de email, 9 herramientas del agente,
// 287 tests, 5 idiomas.
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { projects } from "../../data/projects";
import { resolveLangFromRequest } from "../../lib/lang";

const project = projects.find((p) => p.slug === "osint-d2");
if (!project) return Astro.redirect("/404");

const lang = resolveLangFromRequest(Astro.request);

const copy = {
  es: {
    traceTitle: "Así piensa",
    traceLead: "No sigue una lista fija: encuentra pistas y decide a dónde ir. Esta es una investigación real sobre «torvalds».",
    traceNote: "Si se queda sin pasos, el motor fuerza el informe final: toda investigación termina en algo concreto.",
    toolsTitle: "9 herramientas",
    profileTitle: "Perfil en 6 dimensiones",
    profileLead: "Cada conclusión se apoya en evidencia recogida durante la investigación.",
    anchorsTitle: "Filtra falsos positivos",
    anchorsLead: "Declaras una fuente que sabes que es real («--trust github:usuario») y cada perfil encontrado se puntúa contra ella.",
    anchorsCaption: "Peso de cada señal",
    dossierTitle: "El entregable",
    dossierLead: "Un dossier PDF de estilo clasificado, listo para compartir.",
    deployTitle: "Un comando",
    deployLead: "Dashboard en vivo en localhost:8000. Con Ollama, la IA corre en tu máquina, sin API keys.",
    ethics: "Diseñado solo para investigación de seguridad autorizada, periodismo y OSINT legítimo.",
    summary: "Le das un usuario o un email: un agente de IA lo busca en más de 20 plataformas, encuentra pistas nuevas, las sigue por su cuenta y entrega un perfil de 6 dimensiones basado en evidencia, en un dossier PDF. Open source, listo para Docker y con la IA corriendo en local vía Ollama.",
  },
  en: {
    traceTitle: "How it thinks",
    traceLead: "No fixed checklist: it finds leads and decides where to go next. This is a real investigation of “torvalds”.",
    traceNote: "If it runs out of steps, the engine forces the final report: every investigation ends with something concrete.",
    toolsTitle: "9 tools",
    profileTitle: "6-dimension profile",
    profileLead: "Every conclusion is grounded in evidence gathered during the investigation.",
    anchorsTitle: "Filters false positives",
    anchorsLead: "Declare a source you know is real (“--trust github:user”) and every profile found is scored against it.",
    anchorsCaption: "Weight of each signal",
    dossierTitle: "The deliverable",
    dossierLead: "A classified-style PDF dossier, ready to share.",
    deployTitle: "One command",
    deployLead: "Live dashboard at localhost:8000. With Ollama, the AI runs on your machine with no API keys.",
    ethics: "Built for authorized security research, journalism and legitimate OSINT only.",
    summary: project.description,
  },
}[lang];

// Traza real del README: el agente pivota de usuario → web → emails → informe
const trace = [
  { tool: "scan_username", input: "torvalds", out: lang === "es" ? "11 perfiles confirmados de 19" : "11 confirmed of 19 scanned" },
  { tool: "fetch_url", input: "github.com/torvalds", out: lang === "es" ? "encuentra emails y redes" : "finds emails and social links" },
  { tool: "scan_email", input: "torvalds@linux-foundation.org", out: lang === "es" ? "13 confirmados de 23" : "13 confirmed of 23" },
  { tool: "scan_email", input: "torvalds@kernel.org", out: lang === "es" ? "12 confirmados" : "12 confirmed" },
  { tool: "fetch_url", input: "x.com/torvalds · keybase.io/torvalds", out: lang === "es" ? "cruza X y Keybase" : "cross-checks X and Keybase" },
  { tool: "generate_report", input: lang === "es" ? "perfil 6D" : "6D profile", out: lang === "es" ? "separa al Torvalds real de los suplantadores" : "tells the real Torvalds from impersonators" },
];

const tools = [
  ["scan_username", lang === "es" ? "20 plataformas" : "20 platforms"],
  ["scan_email", "Gravatar · PGP"],
  ["breach_check", "HIBP k-anonymity"],
  ["fetch_url", lang === "es" ? "con protección SSRF" : "SSRF-protected"],
  ["compare_avatars", lang === "es" ? "hash perceptual" : "perceptual hash"],
  ["scan_phone", lang === "es" ? "operador · WhatsApp" : "carrier · WhatsApp"],
  ["search_vector_memory", lang === "es" ? "BM25 sobre la evidencia" : "BM25 over evidence"],
  ["correlate_stylometry", lang === "es" ? "estilo de escritura" : "writing style"],
  ["generate_report", lang === "es" ? "cierra la investigación" : "closes the case"],
];

const dimensions = lang === "es"
  ? ["Identidad", "Geo-temporal", "Psicología OCEAN", "Stack técnico", "Ideología", "OpSec y superficie de ataque"]
  : ["Identity", "Geo-temporal", "OCEAN psychology", "Tech stack", "Ideology", "OpSec & attack surface"];

const weights = [
  { label: lang === "es" ? "Nombre" : "Name", value: 40 },
  { label: "Bio", value: 30 },
  { label: "Avatar", value: 20 },
  { label: lang === "es" ? "Ubicación" : "Location", value: 10 },
];

const dossier = lang === "es"
  ? ["Ficha de identidad", "Matriz de riesgo", "Grafo de entidades, exportable a JSON, Obsidian Canvas, HTML y PNG"]
  : ["Identity card", "Risk matrix", "Entity graph, exportable to JSON, Obsidian Canvas, HTML and PNG"];

const deployFacts = lang === "es"
  ? ["DeepSeek · OpenAI · Ollama", "5 idiomas: ES EN PT AR RU", "CLI + dashboard web", "Python 3.11 – 3.13", "Licencia MIT"]
  : ["DeepSeek · OpenAI · Ollama", "5 languages: EN ES PT AR RU", "CLI + web dashboard", "Python 3.11 – 3.13", "MIT license"];
---

<ProjectLayout project={project} gallery={[]} summary={copy.summary} title={`${project.name} — Agentic OSINT | Ángel Calderón`}>
  <!-- 1. Cómo razona el agente -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content">
      <h2 class="type-h2">{copy.traceTitle}</h2>
      <p class="mt-5 max-w-2xl text-lg text-white/70">{copy.traceLead}</p>

      <ol class="mt-12 relative border-l border-white/10 pl-8 md:pl-12 space-y-8">
        {trace.map((step, i) => (
          <li class="reveal relative">
            <span class={`absolute -left-[2.6rem] md:-left-[3.6rem] top-1 grid h-5 w-5 place-items-center rounded-full ring-4 ring-background ${i === trace.length - 1 ? "bg-[#c2185b]" : "bg-[#800020]"}`} aria-hidden="true"></span>
            <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:gap-6">
              <code class="shrink-0 font-mono text-base md:text-lg text-[#f48fb1] md:w-56">{step.tool}</code>
              <span class="font-mono text-sm md:text-base text-white break-all">{step.input}</span>
              <span class="text-sm text-muted-foreground md:ml-auto md:text-right">→ {step.out}</span>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-10 max-w-2xl text-sm text-muted-foreground">{copy.traceNote}</p>
    </div>
  </section>

  <!-- 2. Herramientas del agente -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content">
      <h2 class="type-h2">{copy.toolsTitle}</h2>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 grid-cols-2 lg:grid-cols-3">
        {tools.map(([name, desc], i) => (
          <li class="bg-background p-4 sm:p-6 transition-colors hover:bg-white/[0.03]">
            <span class="font-display text-3xl text-white/15">{String(i + 1).padStart(2, "0")}</span>
            <code class="mt-3 block break-all font-mono text-sm sm:text-base text-white">{name}</code>
            <span class="mt-1 block text-sm text-muted-foreground">{desc}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Perfil 6D -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content">
      <h2 class="type-h2">{copy.profileTitle}</h2>
      <p class="mt-5 max-w-2xl text-lg text-white/70">{copy.profileLead}</p>
      <ol class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3">
        {dimensions.map((d, i) => (
          <li class="card reveal flex min-h-[9rem] flex-col justify-between p-5 md:p-7">
            <span class="font-display text-4xl text-[#c2185b]">{i + 1}</span>
            <span class="text-lg md:text-2xl font-semibold leading-tight text-white">{d}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Trust anchors -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="type-h2">{copy.anchorsTitle}</h2>
        <p class="mt-5 text-lg text-white/70">{copy.anchorsLead}</p>

        <p class="mt-10 type-meta text-muted-foreground">{copy.anchorsCaption}</p>
        <div class="mt-3 flex h-14 overflow-hidden rounded-lg text-sm font-semibold" role="img" aria-label={weights.map((w) => `${w.label} ${w.value}%`).join(", ")}>
          {weights.map((w, i) => (
            <div class="flex items-center justify-center text-white" style={`width:${w.value}%;background:${["#800020", "#a3154a", "#c2185b", "#e0679a"][i]}`}>
              {w.value}%
            </div>
          ))}
        </div>
        <div class="mt-2 flex text-xs text-muted-foreground" aria-hidden="true">
          {weights.map((w) => <span style={`width:${w.value}%`}>{w.label}</span>)}
        </div>
      </div>
      <button type="button" class="reveal block overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/60" data-zoom="/projects/osint-d2/trust-anchors.webp" aria-label="Trust anchors">
        <img src="/projects/osint-d2/trust-anchors.webp" alt="OSINT-D2 — trust anchors" class="w-full h-auto" loading="lazy" decoding="async" />
      </button>
    </div>
  </section>

  <!-- 5. Dossier PDF -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content grid items-center gap-12 lg:grid-cols-12">
      <button type="button" class="reveal lg:col-span-5 mx-auto block w-full max-w-sm overflow-hidden rounded-xl border border-white/10 shadow-2xl shadow-black/60 -rotate-2 transition-transform hover:rotate-0" data-zoom="/projects/osint-d2/dossier.webp" aria-label="Dossier PDF">
        <img src="/projects/osint-d2/dossier.webp" alt="OSINT-D2 — PDF dossier" class="w-full h-auto" loading="lazy" decoding="async" />
      </button>
      <div class="lg:col-span-7">
        <h2 class="type-h2">{copy.dossierTitle}</h2>
        <p class="mt-5 text-lg text-white/70">{copy.dossierLead}</p>
        <ul class="mt-8 space-y-4">
          {dossier.map((d) => (
            <li class="flex gap-4 text-lg text-white/85">
              <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#c2185b]" aria-hidden="true"></span>
              {d}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. Despliegue -->
  <section class="container-page pb-24 md:pb-32">
    <div class="container-content">
      <h2 class="type-h2">{copy.deployTitle}</h2>
      <p class="mt-5 max-w-2xl text-lg text-white/70">{copy.deployLead}</p>
      <pre class="card mt-10 overflow-x-auto p-6 font-mono text-sm md:text-lg leading-relaxed text-white"><code><span class="text-white/40">$</span> git clone https://github.com/Doble-2/osint-d2 && cd osint-d2
<span class="text-white/40">$</span> cp .env.example .env
<span class="text-white/40">$</span> <span class="text-[#f48fb1]">docker compose up -d</span></code></pre>
      <ul class="mt-6 flex flex-wrap gap-2">
        {deployFacts.map((f) => <li class="tag px-3 py-1.5 text-sm">{f}</li>)}
      </ul>
      <p class="mt-12 border-t border-white/10 pt-6 text-sm text-muted-foreground">⚠ {copy.ethics}</p>
    </div>
  </section>
</ProjectLayout>
