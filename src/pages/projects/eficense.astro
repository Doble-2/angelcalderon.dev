---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { projects } from "../../data/projects";

const project = projects.find((p) => p.slug === "eficense");
if (!project) return Astro.redirect("/404");

// Las tres piezas del sistema, en vez de un bloque de texto
const pillars = [
  {
    title: "Admin dashboard",
    text: "Role-based operations, visitor access and financial reporting at condominium scale.",
    tags: ["Next.js", "PostgreSQL"],
  },
  {
    title: "AI concierge",
    text: "Residents ask on Telegram; a cost-efficient DeepSeek agent answers and issues QR passes.",
    tags: ["DeepSeek API", "Telegram"],
  },
  {
    title: "Hardware bridge",
    text: "Cameras and barriers wired in through custom wrappers and resilient polling.",
    tags: ["Python", "Hikvision", "WebSockets"],
  },
];
---

<ProjectLayout project={project} title={`${project.name} — Enterprise IoT SaaS | Ángel Calderón`}>
  <section class="container-page pb-20 md:pb-28">
    <div class="container-content">
      <h2 class="type-h2">The system</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        {pillars.map((p, i) => (
          <li class="card reveal flex flex-col p-6 md:p-8">
            <span class="font-display text-6xl leading-none text-white/20">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-6 text-xl font-semibold text-white">{p.title}</h3>
            <p class="mt-2 text-muted-foreground">{p.text}</p>
            <div class="mt-auto flex flex-wrap gap-1.5 pt-6">
              {p.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</ProjectLayout>
