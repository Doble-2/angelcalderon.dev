---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
import ProjectPager from "../../components/projects/ProjectPager.astro";

const project = projects.find((p) => p.slug === "eficense");
if (!project) return Astro.redirect("/404");

const dashboard = project.images?.[0] || "/rect1-optimized.webp";
const mobile = project.images?.[1] || dashboard;
---

<Layout
  title={`${project.name} | Angel Calderon — Enterprise IoT SaaS`}
  description={project.description}
  image={dashboard}
  url={Astro.request.url}
>
  <main class="container-content py-10 md:py-14 pt-20 md:pt-14 px-3">
    <!-- Hero -->
    <section class="relative overflow-hidden rounded-3xl border border-border bg-background">
      <div class="absolute inset-0 opacity-70" style="background: radial-gradient(900px 360px at 20% 0%, rgba(16,185,129,0.22), transparent 60%);" />
      <div class="absolute inset-0 opacity-70" style="background: radial-gradient(900px 360px at 80% 20%, rgba(59,130,246,0.18), transparent 60%);" />

      <div class="relative grid lg:grid-cols-12 gap-8 p-6 md:p-10 items-center">
        <div class="lg:col-span-6">
          <div class="flex flex-wrap gap-2">
            <span class="chip">Enterprise</span>
            <span class="chip">IoT</span>
            <span class="chip">AI Concierge</span>
          </div>

          <h1 class="mt-4 type-display bg-gradient-to-r from-emerald-300 via-cyan-300 to-blue-400 bg-clip-text text-transparent">
            {project.name}
          </h1>
          <p class="mt-3 type-lead text-muted-foreground max-w-xl">
            {project.subtitle}
          </p>

          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            {project.links?.demo ? (
              <a class="btn btn-primary w-full sm:w-auto justify-center" href={project.links.demo} target="_blank" rel="noopener noreferrer">
                Demo
              </a>
            ) : null}
            {project.links?.repo ? (
              <a class="btn btn-brand-github w-full sm:w-auto justify-center" href={project.links.repo} target="_blank" rel="noopener noreferrer">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.744.083-.729.083-.729 1.205.085 1.84 1.236 1.84 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.468-2.381 1.236-3.221-.124-.303-.536-1.523.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 013.003-.404c1.02.005 2.045.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.655 1.653.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.37.814 1.102.814 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                </svg>
                <span>Repo</span>
              </a>
            ) : null}
          </div>

          <p class="mt-6 text-sm text-muted-foreground max-w-xl">
            {project.description}
          </p>
        </div>

        <div class="lg:col-span-6">
          <div class="relative">
            <div class="absolute -inset-6 rounded-3xl bg-emerald-500/10 blur-2xl" aria-hidden="true" />
            <div
              class="overflow-hidden rounded-3xl border border-border bg-background shadow-lg shadow-black/10"
              style="transform: perspective(1200px) rotateX(10deg) rotateY(-14deg);"
            >
              <img src={dashboard} alt="Eficense dashboard" class="w-full h-auto object-cover" loading="eager" decoding="async" />
            </div>
          </div>
        </div>
      </div>

      <!-- Metrics bar -->
      <div class="border-t border-border bg-muted">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-0">
          <div class="p-5">
            <div class="text-xs text-muted-foreground">Units</div>
            <div class="mt-1 text-2xl font-bold text-foreground">150+</div>
          </div>
          <div class="p-5 border-l border-border">
            <div class="text-xs text-muted-foreground">Sync</div>
            <div class="mt-1 text-2xl font-bold text-foreground">Real-time</div>
          </div>
          <div class="p-5 border-t md:border-t-0 md:border-l border-border">
            <div class="text-xs text-muted-foreground">AI</div>
            <div class="mt-1 text-2xl font-bold text-foreground">DeepSeek</div>
          </div>
          <div class="p-5 border-t md:border-t-0 md:border-l border-border">
            <div class="text-xs text-muted-foreground">Role</div>
            <div class="mt-1 text-2xl font-bold text-foreground">Architect</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bento features -->
    <section class="mt-10">
      <h2 class="type-h2">Bento Grid Features</h2>
      <p class="mt-2 text-sm text-muted-foreground max-w-3xl">
        A product-grade platform connecting hardware, operations, and an AI concierge.
      </p>

      <div class="mt-6 grid lg:grid-cols-12 gap-4">
        <!-- Big: Admin dashboard -->
        <article class="lg:col-span-7 neomorphic rounded-3xl p-5 overflow-hidden">
          <div class="flex items-center justify-between">
            <h3 class="text-foreground font-semibold">Admin Dashboard</h3>
            <span class="chip">Next.js</span>
          </div>
          <p class="mt-2 text-sm text-muted-foreground">
            Role-based operations, visitor access, and reporting at scale.
          </p>
          <div class="mt-4 overflow-hidden rounded-2xl border border-border bg-background">
            <img src={dashboard} alt="Admin dashboard" class="w-full h-auto object-cover" loading="lazy" decoding="async" />
          </div>
        </article>

        <!-- Tall: Mobile chatbot -->
        <article class="lg:col-span-5 neomorphic rounded-3xl p-5">
          <div class="flex items-center justify-between">
            <h3 class="text-foreground font-semibold">Mobile Concierge</h3>
            <span class="chip">DeepSeek</span>
          </div>
          <p class="mt-2 text-sm text-muted-foreground">
            Cost-efficient AI concierge for resident inquiries and operations.
          </p>
          <div class="mt-4 overflow-hidden rounded-2xl border border-border bg-background">
            <img src={mobile} alt="Mobile access" class="w-full h-auto object-cover" loading="lazy" decoding="async" />
          </div>
        </article>

        <!-- Wide: Hardware integration -->
        <article class="lg:col-span-12 neomorphic rounded-3xl p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-foreground font-semibold">Hardware Integration</h3>
            <div class="flex flex-wrap gap-2">
              <span class="chip">Hikvision</span>
              <span class="chip">Python</span>
              <span class="chip">Polling/WebSockets</span>
            </div>
          </div>
          <p class="mt-2 text-sm text-muted-foreground">
            Cameras + barriers integration via custom wrappers and resilient polling strategies.
          </p>
        </article>
      </div>
    </section>
    <ProjectPager currentSlug={project.slug} />
  </main>
</Layout>
