# Variables de entorno para /api/contact
# Opción A (SendGrid):
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
TO_EMAIL=hola@angelcalderon.dev

# Opción B (SMTP via nodemailer):
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS son necesarios para SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=no-reply@example.com
TO_EMAIL=hola@angelcalderon.dev
